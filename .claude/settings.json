{
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" },
  "permissions": {
    "allow": [
      "Bash(python -m py_compile *)",
      "Bash(python -m pytest *)",
      "Bash(python verify_*)",
      "Bash(python tools/redact_env.py*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./*-write.json)",
      "Read(./*-sa.json)",
      "Bash(cat .env)",
      "Bash(git push *)"
    ]
  }
}
