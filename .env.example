# =============================================================================
# SALES & MARKETING BOT — environment
#
# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
#
#   cp .env.example .env
#
# THIS FILE IS A WORKING CONFIGURATION, not a menu. Every variable the code
# reads is set here, uncommented, to the default it runs with — so the copy
# above starts the bot, and the value you see IS the value in force. Nothing
# important is hiding in the code.
#
# Three kinds of line need your attention:
#   <REQUIRED: ...>   a human-only value. Nothing can default it. Replace it.
#   KEY=              a secret (DISCORD_TOKEN, ANTHROPIC_API_KEY) or an
#                     optional id. Blank is a legal setting and means "unset".
#   KEY=value         a default. Leave it unless you mean to change it.
#
# Retired names live in one block at the very bottom, commented out, each
# saying what replaced it. Setting one of those does nothing at all.
#
# tests/test_env_example.py FAILS THE BUILD if a variable the code reads is
# missing here or is only commented out — so this file cannot quietly fall
# behind the code.
#
# This is a SEPARATE BOT from the PM bot. Do not reuse its token, its channels,
# or its database file.
# =============================================================================


# -----------------------------------------------------------------------------
# IDENTITY  (required)
# -----------------------------------------------------------------------------

# REQUIRED. The bot token of the NEW sales Discord application — not the PM
# bot's. Create the application at https://discord.com/developers/applications,
# add a Bot user, and enable the MESSAGE CONTENT INTENT (the bot reads channel
# messages; without it every message arrives empty).
DISCORD_TOKEN=

# REQUIRED. Your Anthropic API key. Used for question answering, spotting
# commitments, and wording reminders.
ANTHROPIC_API_KEY=

# The model for every LLM call the bot makes.
MODEL=claude-sonnet-4-6


# -----------------------------------------------------------------------------
# SCOPE  (required — this is the most important setting in the file)
# -----------------------------------------------------------------------------

# REQUIRED. Comma-separated channel ids. THE ONLY CHANNELS THIS BOT READS FROM
# OR POSTS IN — enforced in code at both ends (guardrails.py). A channel not in
# this list is invisible to the bot and unreachable by it.
#
# This is the SECOND layer of the scoping rule. The first is server-side: deny
# the bot's Discord role View Channel on every non-sales channel. See DEPLOY.md.
#
# To get an id: Discord → User Settings → Advanced → Developer Mode, then
# right-click a channel → Copy Channel ID.
SALES_CHANNEL_IDS=<REQUIRED: the sales channel ids — comma-separated>

# The channel the bot POSTS in unprompted: the daily digest and the deadline
# announcements land here by default (SALES_DIGEST_CHANNEL_ID overrides the
# digest). Unset → the first channel in SALES_CHANNEL_IDS.
#
# It is NOT an answering exemption. In this channel, exactly like every other
# sales channel, the bot replies ONLY when it is @-mentioned in the message text
# or when someone replies directly to one of its own messages — and never to a
# message that tags somebody else, and never to @here / @everyone. There is no
# no-mention mode anywhere: one function, SalesBot.should_respond() in bot.py,
# decides every reply, and it logs each verdict as
#   [gate] <responded|ignored> msg=<id> reason=<mentioned|reply-to-bot|ignored>
# If the bot answers something it should not have, grep the log for [gate].
#
# If you set this to a channel missing from SALES_CHANNEL_IDS, it is added
# automatically (with a warning) — the ask channel can't become a hole in the
# scope rule.
SALES_ASK_CHANNEL_ID=

# The team roster: the ONLY Discord user ids this bot may @-mention. Comma-
# separated. Anyone not listed is referred to by plain-text name and never
# pinged. Empty means the bot pings nobody — reminders still go out, addressed
# by name.
TEAM_ROSTER_IDS=<REQUIRED: Discord user ids of the sales team — comma-separated>

# Display-name fallback for roster members whose Discord id you don't have yet.
# Comma-separated, case-insensitive. Names are SPOOFABLE, so this only affects
# how someone is referred to — it can never authorise a ping, which needs an id.
TEAM_ROSTER_NAMES=

# Optional JSON map of Discord id → display name, so the bot can name a teammate
# who hasn't posted recently (the candidate pool is built from recent posters).
# Purely cosmetic; grants no permission.
ROSTER_DISPLAY_NAMES=<REQUIRED: {"<discord id>":"Vaishnavi","<discord id>":"Sid"}>


# -----------------------------------------------------------------------------
# PERSONA & POLICY
# -----------------------------------------------------------------------------

# What the bot calls itself, everywhere it speaks: how it introduces itself, the
# name on its state file, and the User-Agent it fetches research papers with.
# Naming is open; "Saley" is the default. One definition, read through config by
# persona.py, main.py, state.py and research.py — so renaming the bot is this
# one variable and a restart, never a search-and-replace.
COS_NAME=Saley

# The operating policy file, RE-READ ON EVERY QUESTION — edit it and the next
# question already runs under the new version, no restart needed.
SALES_POLICY_FILE=./sales_policy.md

# Set false to drop the persona voice block from prompts. The POLICY still
# applies: turning the voice off must not turn the policy off.
COS_PERSONA_ENABLED=true


# -----------------------------------------------------------------------------
# SOURCES
#
# Four sources (sources.py). Each self-reports connected / degraded /
# awaiting-access, and the bot states those statuses honestly when asked what it
# can do. The meeting notes, the GTM spreadsheet and the researcher/buyer mapping
# are wired up; the strategy doc is still a stub.
# -----------------------------------------------------------------------------

# --- sales_meeting_notes (WIRED UP, sync included) ---
# Local folder the Drive meeting-notes docs are synced into. The bot READS local
# files only and holds no Google credential of its own — rclone owns that. The
# folder is CREATED at startup if it doesn't exist; empty NOTES_DIR → the source
# reports awaiting-access.
#
# A file counts as a meeting note if its filename or first lines contain a date;
# .docx, .txt, .md and .html are all readable.
NOTES_DIR=./notes

# THE SYNC COMMAND — a full rclone invocation, run through the shell at startup,
# every NOTES_SYNC_MINUTES, and on demand before a notes question is answered.
# Unset → nothing ever refreshes NOTES_DIR and the bot reads what is already
# there (it says so in its status rather than pretending to be current).
#
# WINDOWS: this runs as a SUBPROCESS, which does NOT see PowerShell aliases or
# functions. If `rclone` in your terminal is an alias, the bot will fail with
# "not recognized as an internal or external command". Put rclone.exe on PATH, or
# write the full path here:
#   NOTES_SYNC_CMD=C:\rclone\rclone.exe copy gdrive: ./notes --drive-shared-with-me --drive-export-formats txt
#
# A failing sync is not fatal: it is logged ONCE with the fix, the meeting-notes
# source reports DEGRADED, and answers say the notes may be stale.
NOTES_SYNC_CMD=

# How often the background sync runs, in minutes. Default 30.
NOTES_SYNC_MINUTES=30

# Hard timeout for ONE sync run, in seconds. The first sync pulls every doc and
# is far slower than the incremental ones. Default 120.
NOTES_SYNC_TIMEOUT_SECONDS=120

# --- WHICH synced notes stay OUT of context (the EXCLUDE list) ---
# The sync pulls every "Notes by Gemini" doc shared with the sync account, and
# the bot loads ALL of them EXCEPT the recurring product standups. A doc is
# excluded when its TITLE contains any of these patterns — comma-separated,
# matched case-insensitively as a substring. Everything else (PM calls, customer
# calls, ad-hoc meets) is loaded and readable.
#
# The title is the filename, or the document's first line when the filename has
# no title. Only the title is matched, never the body: a real meeting whose notes
# merely MENTION "the PM sync" is still a real meeting.
#
# WHY EXCLUDE AND NOT INCLUDE. This used to be an include-list — a note counted
# only if its attendee list named a specific person or its title carried a sales
# keyword. On the live folder that admitted ZERO of 72 synced docs: the invite
# list doesn't survive the Gemini export, and nobody titles a real call "sales
# sync". An include-list that matches nothing is indistinguishable from "no
# meetings happened", which is the exact failure the notes pipeline exists to
# prevent. The worst an exclude-list does is put a standup in context — visible,
# and harmless. With the default below the same folder loads 2 and excludes 70.
#
# Widen it to keep more out; set it EMPTY to load absolutely everything,
# standups included (legal, and logged at startup so it isn't a surprise).
NOTES_EXCLUDE_TITLE_PATTERNS=AM sync,PM sync

# --- sales_spreadsheet: the GTM Playbook (WIRED UP, Google Sheets API) ---
#
# Read LIVE through the Sheets API with a service account. The sheet is never
# exported, downloaded or synced — rclone is only for the meeting-notes docs.
# See the GTM SPREADSHEET section below for the ids, auth and write rules.

# --- strategy_doc (WIRED UP — strategy.py, read-only over the Drive API) ---
#
# The HUMAN-OWNED strategy document: Vaishnavi's edited version of the v2 draft,
# once it is in Drive. Three things run against it, and none of them worked while
# this was a stub:
#
#   the deadline cadence   a cadence STATED IN THE DOC outranks the working-day
#                          defaults below. "Follow up after 4 working days" in
#                          the doc makes every outreach deadline 4 days, and the
#                          announcement then says "per the strategy doc".
#   stale-doc enforcement  Drive's modifiedTime against STRATEGY_STALE_DAYS.
#   outreach-vs-plan       the targets the doc names, against where outreach
#                          actually went. Reported both ways: a segment worked
#                          that the plan doesn't name, and a target the plan
#                          names that nothing went to.
#
# THE BOT HAS READ-ONLY ACCESS AND NO CODE PATH THAT COULD WRITE TO IT — see the
# scope list in drive.py. Share the doc with the service account as VIEWER.
#
# STRATEGY_DOC_FILE IS THE BOT'S CORE BRAIN, AND IT DEFAULTS TO A REAL PATH.
# `./sales_strategy.md` at the repo root is loaded into the SYSTEM PROMPT OF
# EVERY MODEL CALL — answers, proactive message composition, research reasoning,
# reply extraction — and it is RE-READ ON EACH CALL, exactly like
# sales_policy.md. Edit the file, ask the next question, and the new strategy is
# already in force: no restart, no redeploy.
#
# WHERE sales_strategy.md AND sales_policy.md DISAGREE, THE STRATEGY DOC WINS.
# That precedence is stated inside the prompt itself, so it holds for every rule
# — including ones nobody has got round to de-duplicating by hand.
#
# IF THE FILE IS MISSING the bot does NOT invent a strategy. It logs an ERROR at
# startup naming the path, every prompt carries a note saying the strategy is
# unreadable, and the bot says so when asked about the plan.
STRATEGY_DOC_FILE=./sales_strategy.md

# STRATEGY_DOC_ID is the Drive file id (the long string in the doc's URL between
# /d/ and /edit). Set it when the plan also lives in Drive: it is what the
# STALENESS check and the outreach-vs-plan check read, because both need Drive's
# modifiedTime, which a local file cannot provide.
STRATEGY_DOC_ID=

# HOW MUCH OF THE STRATEGY DOC RIDES IN EACH PROMPT. The doc is in the system
# prompt of every model call, so an unbounded one is paid for on every question.
# Past this many characters it is cut — and the prompt SAYS it was cut, so the
# bot can tell you a question turns on a part it could not see. 0 = no limit.
STRATEGY_PROMPT_MAX_CHARS=24000

# Past this many CALENDAR days with no revision, the plan is reported STALE and
# every answer that quotes it says so first. Calendar, not working, days: a plan
# going stale over a long weekend is still going stale. 0 turns the rule off
# (the revision date is still reported).
STRATEGY_STALE_DAYS=30

# How long a read of the doc is cached. A FAILED read is cached for the same
# interval, so a doc nobody has shared yet doesn't cost every question a round
# trip to a 403.
STRATEGY_CACHE_MINUTES=30

# The outreach-vs-plan check: master switch, and the two bounds that stop a
# verbose plan producing a verbose digest section.
#
# HOW THE TARGETS ARE READ, because it decides what belongs in the doc: the bot
# takes the lines under a heading that says TARGET / ICP / SEGMENT / VERTICAL /
# PRIORITY, and NOTHING else. A bulleted list ends at the first non-bullet line;
# an unbulleted one ends at the first blank line. If the doc has no such heading
# the bot SAYS SO rather than guessing at a plan and then reporting drift against
# its own guess.
STRATEGY_CHECK_ENABLED=true
STRATEGY_MAX_TARGETS=40
STRATEGY_MAX_FINDINGS=6

# Hard timeout for one Drive / Docs / Sheets REST call (drive.py).
DRIVE_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# MEETING CITATIONS  (meetings.py)
#
# THE RULE: whenever meeting knowledge shapes a line — a hold, a decision, a
# commitment — the line NAMES ITS SOURCE:
#
#     "OpenAI ... last followed up 144d ago. Follow up or park it.
#      — on hold (Sales Bot Discussion, 2 Sep)"
#
# It applies everywhere: digest items, cadence chases, the tracker reminder, prep
# briefs, the to-do sheet's "Source meeting" column, and answers to questions.
#
# THERE IS NO SETTING THAT TURNS THIS OFF, deliberately. A claim from a sheet can
# be checked by opening the sheet — the bot names the cell it read. A claim from
# a meeting cannot be checked at all unless it says which meeting, so an uncited
# one is indistinguishable from something the bot made up.
#
# The two knobs below only bound how much work the layer does: a folder of 300
# documents must not be re-parsed in full for every digest section.
# -----------------------------------------------------------------------------

# How far back the knowledge layer looks for holds, decisions and commitments.
MEETING_FACTS_DAYS=45
# How many notes one pass may open.
MEETING_FACTS_MAX_NOTES=40


# -----------------------------------------------------------------------------
# THE TRACKER REMINDER  (a SECTION of the digest, never its own message)
#
# Vaishnavi's twice-weekly "update the tracker" prompt. It is a SECTION INSIDE
# that day's daily digest and it has NO SEND PATH OF ITS OWN — there is nowhere
# in the code it could become a second message. Two prompts about the tracker,
# minutes apart, is how a channel gets muted.
#
# It carries the count of rows currently missing the dates every cadence rule
# depends on, so it is worth reading rather than skimming, and it posts even on a
# day with nothing else outstanding because it is a real ask.
# -----------------------------------------------------------------------------

TRACKER_REMINDER_ENABLED=true
# Which days carry it. mon..sun or 0-6, comma separated.
TRACKER_REMINDER_DAYS=mon,fri


# -----------------------------------------------------------------------------
# THE TO-DO SHEET  (todos.py)
#
# ONE Google Sheet — "Membrane Sales To-Dos" — created by the bot on first run,
# SHARED with the team, and appended to weekly from the meeting notes.
#
#   columns   # | To-do | Owner | Source meeting | Date raised | Due | Status | Notes
#   the bot   APPENDS only. It never edits a row and never deletes one.
#   humans    own Status and Notes entirely.
#
# SHARING IS THE FEATURE, NOT A NICETY. A spreadsheet the service account creates
# is OWNED BY the service account and lives in a Drive no human can browse or
# search. Until it is shared it is invisible — not "hard to find", invisible.
# That is why TEAM_SHARE_EMAILS has a default rather than being optional, why
# share failures are reported per address, and why the link is posted in the
# sales channel — as a section of the daily digest, so it is still one message
# a day.
#
# REQUIRES THE GOOGLE DRIVE API TO BE ENABLED for the service account's Cloud
# project. It is a one-time click in the Cloud console. Until it is, creation
# fails with a bare "The caller does not have permission" from Google, and the
# bot translates that into the console URL that actually fixes it.
# -----------------------------------------------------------------------------

TODO_SHEET_ENABLED=true

# The sheet's title.
TODO_SHEET_TITLE=Membrane Sales To-Dos

# NORMALLY LEFT EMPTY. The bot creates the sheet on first run and remembers the
# id in its own config store (the `meta` table in DB_PATH), so a restart re-opens
# the same sheet instead of making a second one. Set this only to point the bot
# at a sheet somebody created by hand — it overrides the stored id.
TODO_SHEET_ID=

# WHO THE SHEET IS SHARED WITH, as EDITOR. See the note above: without this the
# sheet exists and nobody can open it.
TEAM_SHARE_EMAILS=trishi@nfthing.com,vaishnavi@membrane.social,claudedrive@nfthing.com

# Send Google's own "X shared a file with you" email as well. Off by default: the
# link is posted in the sales channel, and an email to every address on every
# redeploy is noise that post already covers.
TODO_SHARE_NOTIFY=false

# Which day's digest carries the weekly refresh, and its one line
# ("To-do sheet updated: +N new . <link>"). mon..sun or 0-6.
TODO_REFRESH_DAY=fri

# How far back the refresh reads meeting notes for action items.
TODO_NOTES_DAYS=7

# Bounds: how many new rows one refresh may append, and how many open items the
# "show the to-dos" answer prints before it stops and leans on the link.
TODO_MAX_NEW_PER_REFRESH=25
TODO_SHOW_MAX=20


# -----------------------------------------------------------------------------
# GTM SPREADSHEET — auth, ids and the write rules
#
# ONE spreadsheet: "NFThing <> GTM Playbook", read AND written in place. The
# sandbox copy is gone — there is no mirror, no COPY id and no sync. What
# protects the sheet now is the permission flow (every write is proposed and
# approved before it happens) and the column bands below, not a second
# document; see RESTRICTED_COLUMN_RANGES and SHEET_WRITE_MAX_CELLS.
#
# TABS ARE FOUND BY NAME, not by content. Six of them:
#   Outreach PoCs          the canonical tab — one row per contact, A–X, and
#                          the only tab the bot ever writes to
#   Master Pipeline        companies, for R11's "new company" screen
#   Deliverables Checklist R4's deadlines
#   Sales Packages         R12's readiness
#   AI Events & Summits    R3's conferences
#   Q4 Goal Setting        the quarter's targets
#
# Each has a *_TAB_TITLES setting below holding the titles to look for, so a
# renamed tab is one env change. A title that matches nothing is an ERROR in the
# boot log, not a shrug: a name-discovered tab that is not found makes every
# feature reading it go quiet without saying why. Headers within a tab are still
# discovered at parse time, so a reordered or added column needs no change.
# -----------------------------------------------------------------------------

# Path to the Google service-account key file (JSON).
#
# SECRET. It can READ AND WRITE the GTM Playbook. .gitignore covers the usual
# key filenames; never commit one. If a key is ever committed, revoke it in the
# Google Cloud console: deleting the file is not enough.
#
# Setup, once:
#   1. Google Cloud console → create a project → enable the GOOGLE SHEETS API.
#   2. Create a service account → Keys → Add key → JSON → download it here.
#   3. SHARE BOTH SHEETS with the service account's client_email:
#        - the GTM PLAYBOOK as EDITOR     (it is written to now — see below)
#        - the MAPPING sheet as Viewer    (see GTM_MAPPING_SHEET_ID below —
#          Viewer is correct AND sufficient; the bot never writes to it)
#      Without step 3 every read returns 403 and the bot reports that spreadsheet
#      as awaiting-access, logging the exact share line to run.
#
# EDITOR, NOT VIEWER, AND THAT IS A CHANGE. The sandbox copy is retired; the bot
# writes into the real playbook. A Viewer share reads perfectly and then fails on
# the first write, with a 403 the bot translates into "shared read-only, needs
# Editor" — which is a bad thing to discover on the day somebody replies to a
# nudge.
GOOGLE_SERVICE_ACCOUNT_JSON=<REQUIRED: path to the service-account JSON — e.g. ./sales-bot-sa.json>

# The playbook's spreadsheet id (the long string in the sheet URL between /d/
# and /edit). Defaults to the real NFThing sheet, so it normally needs no
# setting — it is here so a fork or a test can point elsewhere.
GTM_SHEET_ORIGINAL_ID=15fhmQAOVoABg2TpxSRL57LhC_I-62hZZAspl1Dqd_fs


# -----------------------------------------------------------------------------
# WRITING TO THE SHEET — the sandbox-copy era is over
#
# GTM_SHEET_COPY_ID, SHEET_WRITE_TARGET and BOT_DEADLINE_COLUMN are REMOVED.
# Setting any of them now does nothing.
#
# WHAT THEY WERE. The bot owned one column — "Next Deadline (bot)", appended at
# the far right — and wrote single cells into it, on a SANDBOX COPY of the
# playbook by default. That was the right shape while nobody had agreed what the
# bot may touch, and it was useless for exactly as long: a column on a copy
# nobody opens is a write into a drawer, and the two sheets were only ever
# row-aligned by luck.
#
# WHAT REPLACES IT, per Vaishnavi's walkthrough: the bot writes into the REAL
# Outreach PoCs tab, into the columns the team already keeps, and ONLY inside the
# WRITABLE WINDOW between the restricted bands (RESTRICTED_COLUMN_RANGES —
# default A:I and S:X, the identity block and the formula block, refused in code
# since V1).
#
# TWO TRIGGERS, AND NOTHING ELSE WRITES:
#   (a) a team member REPLIES to one of the bot's own messages;
#   (b) a team member @-mentions it with an explicit command
#       ("update Sahaj's meeting to Friday").
# No schedule writes. No inference from a passing remark in the channel.
#
# THE FILL RULE: an EMPTY cell is filled; a NON-EMPTY cell changes only when the
# reply clearly supersedes it ("moved to Friday", "actually it went Tuesday").
# Filling a blank is recoverable; overwriting what somebody typed destroys
# information, so it needs them to have actually said the new thing.
#
# THREE TIERS:
#   REPLY-LOOP    first-contact type/date, connection date, DM-sent date,
#                 Responded?, meeting status/date, next steps, notes, package
#                 sent, assets shared, prospect status.
#   COMMAND-ONLY  closure probability, deal size, deal status. Commercial
#                 judgements — a number mentioned in passing is not a number
#                 somebody committed to the sheet.
#   NEVER         anything in a restricted band.
#
# THE BANDS OUTRANK THE TIERS. If a command-only column physically sits inside a
# restricted band on the real sheet, NO instruction can write it and the bot says
# so by name. To let the bot maintain those columns they must live in the
# writable window — that is a decision somebody makes on purpose here, not
# something a sufficiently explicit command quietly wins.
#
# CONTACT DETAILS IN A REPLY (an email, a LinkedIn link, a phone number) are
# ACKNOWLEDGED AND HANDED BACK: "I have got the email address — that column is
# one I never write to, so could you drop it in yourself?" Never written,
# never silently dropped.
#
# EVERY WRITE IS ECHOED in one friendly line, recorded in audit.jsonl, and
# UNDOABLE by any team member for SHEET_WRITE_UNDO_HOURS — the exact prior cell
# values are kept in SQLite.
#
# SQLITE REMAINS THE BRAIN. Deadlines, snoozes, scheduled reminders, activations
# and the drip's slot log are all there and authoritative. The sheet is what the
# TEAM reads; SQLite is what the bot knows.
# -----------------------------------------------------------------------------

# Master switch for cell writes. false → the bot still reads, extracts and ECHOES
# what it WOULD have written (saying so), and changes nothing. Worth a week of
# that before letting it touch the sheet, to watch the extraction get it right.
SHEET_WRITES_ENABLED=true

# How long "undo" stays available, in hours. Any team member may undo any write
# in this window — not just whoever caused it, because the person who spots a
# wrong cell is usually not the person who typed the sentence that produced it.
#
# 24 IS THE POINT, NOT A DETAIL. The bot changes cells in the sheet the team
# actually works in, on the strength of a sentence in a channel. That is only
# acceptable if it is trivially reversible by whoever notices, and noticing
# usually happens the next morning.
SHEET_WRITE_UNDO_HOURS=24

# MOST CELLS ONE MESSAGE MAY CHANGE. A safety ceiling, not a target: one sentence
# should touch one or two cells, and an extraction that suddenly wants nine has
# misread something. Past this the write is refused WHOLE — never half-applied —
# and the bot says so and asks for one thing at a time.
SHEET_WRITE_MAX_CELLS=4

# WORDS THAT MUST APPEAR VERBATIM before the bot will set a prospect or deal
# status to a terminal value. "Dead" and "Unresponsive" STOP a row for good in
# the next-action engine, so the bot never infers one from tone or from a long
# silence — somebody has to have actually said it. Matched against the raw
# message text, not against the model's interpretation of it.
TERMINAL_STATUS_WORDS=dead,unresponsive,not interested,no longer interested,drop them,drop it,write it off,write them off,close it,closed lost,lost


# -----------------------------------------------------------------------------
# SUPPRESS-OR-CONVERT — check before you nudge
#
# BEFORE ANY PROACTIVE MESSAGE GOES OUT, the bot looks for evidence that the
# thing it is about to ask for has already happened: in the synced meeting notes
# and in what the team said in the sales channels. Both sources were already
# exposed to the answer path; this reuses them rather than re-implementing them.
#
# EVIDENCE DOES NOT SILENCE THE NUDGE, IT CHANGES IT:
#
#   task    "Vaishnavi — has the DM to Sahaj gone out?"
#   offer   "Looks like Sahaj Labs is already handled — meeting booked with Sahaj
#            Friday 3pm (Vaishnavi in channel, Tue 08 Sep). Want me to mark the
#            meeting as booked on the row? Just say yes."
#
# Suppressing would leave the row wrong AND tell nobody, and a bot that goes
# quiet is indistinguishable from one that has broken. The offer closes the loop
# with one word back — and "yes" applies exactly the change it showed you,
# through the same tiers, bands and fill rule as any other write.
#
# EVIDENCE IS A LADDER, not a lookup. Evidence at or above a nudge's stage
# converts it: a booked meeting supersedes a DM check, a reply supersedes a
# follow-up. That is the case that matters most — chasing a DM the morning after
# the meeting was booked is the thing everyone in the channel can see is wrong.
#
# IT MATCHES ON HOW PEOPLE ACTUALLY NAME AN ACCOUNT — the company, its
# distinctive words, and the PoC's name. The sheet says "Sahaj Labs" and the
# channel says "Sahaj", and a matcher that only knew the full company string
# found nothing.
#
# THE PHRASES ARE PAST TENSE. "Will send" and "should book" are the opposite of
# evidence — they are the thing the nudge is about.
#
# EVERY CONVERSION IS LOGGED with the sentence that caused it and where it came
# from (nudge_conversions in SQLite, plus a nudge_converted line in
# audit.jsonl), because a conversion is a judgement and a wrong one is otherwise
# invisible.
# -----------------------------------------------------------------------------

# Master switch. false → every nudge goes out as a task, whatever the notes say.
SUPPRESS_OR_CONVERT_ENABLED=true

# How far back to look for evidence, in days. SHORT ON PURPOSE: a note from three
# weeks ago saying "we'll book something" is not evidence that a meeting exists
# now, and treating it as such would offer to record something that never
# happened.
NOTES_LOOKBACK_DAYS=7


# -----------------------------------------------------------------------------
# RESEARCH BRIEFS — mention-triggered only, and copy material
#
# "brief me on Sahaj (Sahaj Labs)" → who they are, how much their role weighs
# (someone who can say YES vs someone who has to ASK), which of their work maps
# to our lanes, an angle, and a DRAFT message to personalise.
#
# IT IS NEVER SENT AND NEVER WRITTEN TO THE SHEET. The bot has no outbound
# channel to a prospect and this does not give it one — it hands a human a draft
# to edit. The hard limit in sales_policy.md is unchanged.
#
# THERE IS NO SCHEDULED BRIEF. Somebody asks, or nothing happens.
#
# IT ONLY READS URLS ALREADY ON THAT PERSON'S ROW. The bot does not search the
# web, does not follow links out of a page it fetched, and never guesses a URL
# from a name. No links on the row → the brief says so and stops.
#
# THE LANES COME FROM sales_policy.md AND THE STRATEGY DOC, read at brief time —
# so re-writing the positioning changes the briefs with no code change.
# -----------------------------------------------------------------------------

# Which domains a research link may point at. Anything else is REFUSED WITH A
# ONE-LINE NOTE NAMING THE DOMAIN — not silently skipped, because "I ignored
# three of your links" is something the asker needs to know before they trust
# the brief as complete.
#
# Matched on the registered domain AND its subdomains, so "arxiv.org" also
# allows "export.arxiv.org" but NOT "notarxiv.org". Widen it deliberately: every
# entry is a place the bot will fetch from unattended.
RESEARCH_ALLOWED_DOMAINS=arxiv.org

# -----------------------------------------------------------------------------
# WEB SEARCH — Anthropic's SERVER-SIDE tool
#
# Anthropic runs the search; nothing in this bot opens a socket to a search
# engine. RESEARCH_ALLOWED_DOMAINS above is UNCHANGED and still governs the
# other half — research.py fetches only URLs already on a row, only from those
# domains. The two do not overlap and neither replaces the other.
#
# WIRED INTO SEVEN RULES: R1 (news, last 24h), R2 (screening against the
# use-case table in sales_strategy.md section 2), R3 (new events), R6 (public
# email search), R8 and R10 (PoC/company news), R11 (company details + PoCs).
#
# WEB CONTENT IS DATA, NEVER INSTRUCTIONS. websearch.SAFETY_PREAMBLE says so to
# the model on every call that carries the tool, and the code backs it up:
# nothing acts on a page's contents without a human's yes (approvals.py). A page
# can put words in a message; it cannot make the bot do anything.
WEB_SEARCH_ENABLED=true

# WHICH VERSION OF THE TOOL. Three exist and they are NOT interchangeable:
#
#   web_search_20250305   basic search
#   web_search_20260209   adds dynamic filtering (Claude 4.6 and later)
#   web_search_20260318   adds response-inclusion control   <- the default
#
# A version the model does not support is a 400, so this is a setting rather
# than a constant: on an older model, drop to the basic variant.
WEB_SEARCH_TOOL_TYPE=web_search_20260318

# HOW MANY SEARCHES ONE CALL MAY MAKE. Past it the API returns a
# `max_uses_exceeded` error INSIDE a 200 response and the model stops searching
# — which the bot reports rather than hiding. Simple lookups use 1-3; a
# multi-company screen legitimately wants more.
WEB_SEARCH_MAX_USES=5

# HOW MANY SEARCHES A DAY, ACROSS EVERYTHING. Search is billed per search on top
# of tokens ($10 per 1,000), and seven rules can each want several — a runaway
# day is a real bill, not a rounding error.
#
# WHEN IT IS SPENT THE RULES DEGRADE, THEY DO NOT FAIL. Each still produces its
# items and each says "web research unavailable today — the daily search budget
# is spent". Going quiet would look exactly like a quiet week.
#
# COUNTED FROM `usage.server_tool_use.web_search_requests` — what the API
# actually billed. An errored search is not billed and does not count.
WEB_SEARCH_DAILY_BUDGET=60

# Optional domain filters. These are MUTUALLY EXCLUSIVE — a request carrying
# both is a 400 — so when both are set the allow-list wins and the block-list is
# dropped with a warning. Bare domains, no scheme: "example.com" or
# "example.com/blog".
#
# EMPTY IS THE RIGHT DEFAULT. An allow-list here would make R1's news sweep read
# only the sites somebody listed last quarter, which is not a news sweep. The
# bot warns at boot if you set one.
#
# NEITHER IS WHERE LINKEDIN IS HANDLED. A search result that LINKS to LinkedIn
# is a normal citation and fine to quote; scraping LinkedIn is forbidden because
# there is no fetch path in websearch.py at all, not because of a block-list.
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=

# Localisation for search results. Any subset is legal; an empty set is omitted.
# The country is an ISO 3166-1 alpha-2 code and the API rejects an unsupported
# one with a 400.
WEB_SEARCH_CITY=Bengaluru
WEB_SEARCH_REGION=Karnataka
WEB_SEARCH_COUNTRY=IN
WEB_SEARCH_TIMEZONE=Asia/Kolkata

# "full" or "excluded". On web_search_20260318 and later, "excluded" drops the
# raw search-result blocks from the response once a completed code execution has
# consumed them — fewer output tokens on search-heavy calls. THE CITATIONS AND
# THEIR LINKS ARE UNAFFECTED, which is what the messages actually need. Ignored
# (with a log line) on older tool versions.
WEB_SEARCH_RESPONSE_INCLUSION=full

# THE ESCAPE HATCH FOR A MODEL WITHOUT PROGRAMMATIC TOOL CALLING. On
# web_search_20260209 and later, `allowed_callers` defaults to
# ["code_execution_20260120"] and the API provisions that code execution itself
# — do NOT also declare the code execution tool anywhere. A model that cannot do
# it returns a 400 telling you to set ["direct"]; that is what this is for.
# Empty means "send nothing and take the tool's own default".
WEB_SEARCH_ALLOWED_CALLERS=

# Bounds on one fetch, so a slow or enormous page degrades the brief instead of
# hanging an answer somebody is waiting on.
RESEARCH_FETCH_TIMEOUT_SECONDS=12
RESEARCH_FETCH_MAX_BYTES=400000

# Most links one brief will fetch. A row with twelve papers on it is a reading
# list, not a brief; anything past this is named in the refusal line.
RESEARCH_MAX_LINKS=4

# LINKEDIN. Set an access token, OR a client id and secret, to enable the
# LinkedIn half of a brief.
#
# UNSET IS THE CURRENT STATE, and the brief SAYS SO — "LinkedIn access is
# pending" — in those words, where the career history would have gone. A gap
# nobody mentions reads as "this person has no notable history", which is a
# different and wrong claim.
#
# THERE IS NO SCRAPING FALLBACK AND THERE MUST NOT BE ONE. LinkedIn's terms
# forbid it, and a bot that scrapes on a team's behalf puts the team at risk.
LINKEDIN_API_ACCESS_TOKEN=
LINKEDIN_API_CLIENT_ID=
LINKEDIN_API_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# EVENTS & SUMMITS
#
# The playbook's "Events & Summits" tab. Each event earns ONE reminder, at
# T-EVENT_LEAD_DAYS, and never another.
#
# ONCE, FOREVER. The dedup is a PERMANENT SQLite row (event_reminders), not a
# per-day marker: a conference the team has already decided about does not need
# reminding twice, and "we mentioned it in March" is not a reason to mention it
# again in April. The key is the event's name AND its date, so an event that
# MOVES earns a fresh reminder — the new date is new information.
#
# IT RIDES THE DRIP. It counts against DAILY_MESSAGE_CAP and the kill switch
# applies to it, like everything else the bot says unprompted.
#
# The reminder is recorded only once the message has actually LANDED — recorded
# before the send, a refused message would burn an event's single reminder
# forever, and "forever" is not a word to be careless with.
# -----------------------------------------------------------------------------

EVENTS_ENABLED=true

# Days before the event that the single reminder fires. 20 is the plan's number:
# far enough out that a booth, a talk slot or a flight is still bookable, close
# enough that it is not immediately forgotten again.
#
# It is a WINDOW, not an exact day — the event being between today and T+20 is
# what makes it due. The drip can only speak when a slot is free, and an
# exact-day test would drop a once-forever reminder entirely on a busy Tuesday.
EVENT_LEAD_DAYS=20

# THE EVENTS TAB, FOUND BY NAME. Comma-separated candidate titles, matched
# case-, space- and punctuation-insensitively. Its header signature ("a name and
# a date") is genuinely weak — half a playbook's tabs match it — so the name
# decides, not the signature.
#
# Live headers: Sr No · Location · Event Name · Link · Date · Timings · Key
# People Attending · Last day for registration · Registered? · Attended?
#
# ITS DATES ARE FREE TEXT and all of these are on the tab right now:
# "15-10-2026", "October 20-21,2026", "4-5 November 2026", "13-15 Oct, 2026",
# "23 September" (no year — read as the NEXT occurrence) and "not available"
# (read as UNKNOWN, which is an answer rather than a parse failure).

GTM_EVENTS_TAB_TITLES=AI Events & Summits,AI Events and Summits,Events & Summits,Events and Summits,Events,Summits

# -----------------------------------------------------------------------------
# THE WEEKLY FUNNEL LINE — opt-in
#
# One short Friday message: leading counts, then lagging counts. Nothing else.
# No commentary, no trend, no "up 12% on last week" — the bot does not have
# enough weeks of clean data to say anything about a trend, and a confident
# sentence about noise is worse than a number.
#
# OFF BY DEFAULT, PER THE PLAN. A weekly number nobody asked for is the
# definition of a message that gets skimmed, and it spends one of the day's
# three slots. Turn it on when somebody actually wants it.
#
# It rides the drip and is ranked LAST, so it can never take a slot from a reply
# somebody is waiting on.
# -----------------------------------------------------------------------------

WEEKLY_FUNNEL_ENABLED=false
# 0=Monday ... 4=Friday. Which weekday carries it.
WEEKLY_FUNNEL_WEEKDAY=4

# How long a read is cached, in seconds. Reads are live at answer time; this only
# stops a burst of questions from spending the API quota. On an API failure the
# last cached read is used and the answer carries an explicit staleness note.
SHEET_CACHE_SECONDS=60

# Override the header→role mapping when a tab's wording is genuinely ambiguous.
# Headers are auto-discovered, so this is only for when auto-detection picks
# wrong. Keys are tab kinds (outreach_pocs / master_data / positioning_matrix
# / prospect_priority / lead_pipeline / funnel_pivot / researcher_lines), then
# role → the LITERAL header text in the sheet.
#
# THIS IS THE KNOB THAT RE-POINTS THE BOT AT RENAMED COLUMNS. A sheet that calls
# the PoC column "Champion" is one env line, not a code change.
#
# THE TWO THAT MATTER MOST are `first_contact_date` and `li_connected_date` on
# the canonical tab: they are the ACTIVATION columns, and a row is invisible to
# every proactive feature unless one of them holds a date. If the startup log
# shows almost no active rows, check that those two roles mapped to the right
# headers before checking anything else.
#
#   outreach_pocs (THE CANONICAL TAB — found by name, columns discovered).
#   Its 24 columns, A-X, and the role each one carries:
#     A Sr No                 sr_no
#     B Company/Uni           company
#     C Industry              industry
#     D Name                  name
#     E Designation           designation
#     F Email id              email
#     G Based                 based
#     H Research Paper Link   paper_links
#     I LI Url                li_url
#     J First Contact         first_contact          <- writable window
#     K First Contact Type    first_contact_type     <- writable window
#     L First Contact Date    first_contact_date     <- writable window
#     M Sid - LI Addition     sid_li_added           <- writable window
#     N LI Connected Date     li_connected_date      <- writable window
#     O LI DM Sent            li_dm_sent             <- writable window
#     P LI DM Date            li_dm_date             <- writable window
#     Q Meeting Date          meeting_date           <- writable window
#     R Meeting Status        meeting_status         <- writable window
#     S Next Steps/Notes      next_steps
#     T Package               package
#     U Prospect Status       prospect_status
#     V Closure Prob%         closure_prob
#     W Estd. Deal Size (USD) deal_size
#     X Deal Status           deal_status
#
#   THE TRACKER-ERA ROLES ARE RETIRED and no longer exist on this tab:
#     poc_vertical · phone · use_case · intro_date · last_followed_up ·
#     followups_count · response · reason · assets_shared · other_updates ·
#     owner · status
#   A tab that still carries one of those columns is READ (it lands in the
#   tab's `_extra` and the bot will quote it) but NO RULE evaluates it, and the
#   startup log names any it finds so the retirement is never silent.
#
#   RENAMED, NOT RETIRED. These old role names still resolve, as a compatibility
#   shim, to the column their successor found — poc->name,
#   poc_designation->designation, linkedin->li_url, research_links->paper_links,
#   first_contacted->first_contact_date, connected->li_connected_date,
#   dm_sent_date->li_dm_date, prospect_stage->prospect_status,
#   closure->closure_prob, package_sent->package. Use the NEW names here.
#
#   master_data (status only):
#     company · industry · poc · poc_designation · poc_vertical · month ·
#     connected · intro_sent · response_status · meeting_done · assets_shared ·
#     asset_detail · owner
#   lead_pipeline: company · priority · lead_stage · est_value · likelihood ·
#     lead_source · geography · remarks · won_lost_reason
#   funnel_pivot: vertical_stage · contacted · connected · intro_sent ·
#     positive · meeting_done · assets_shared
#   researcher_lines: company · outreach_line · dates · funding · geography
#
# NAMING AN "owner" COLUMN HERE IS HOW LINES STOP BEING ADDRESSED TO ONE PERSON.
# Without one every line resolves to SALES_DEFAULT_OWNER_ID; the day the tab
# grows an owner column, this points at it.
#   deliverables_checklist: sr_no · action_item · dependency · priority ·
#     deadline · timelines · link · status · reminder_freq
#   sales_packages: package · name · purpose · use_case · size · audio_files ·
#     image_files · jsonl_output · product_doc · completion · ready · status
#   events_summits: sr_no · location · event · link · event_date · timings ·
#     key_people · registration_deadline · registered · attended
#   goal_setting: motion · goal · metric · target · owner · timeline · status ·
#     notes  (everything else on the tab rides in `_extra`, keyed by its own
#     header — the tab holds TWO stacked tables and one header row cannot
#     describe both)
GTM_COLUMN_MAP=


# -----------------------------------------------------------------------------
# THE CANONICAL TAB — "Outreach PoCs", found BY NAME
#
# PHASE 2 MOVED THE BOT'S SHEET WORLD. Everything the bot says on its own
# initiative now comes from the "Outreach PoCs" tab of the GTM Playbook
# (GTM_SHEET_ORIGINAL_ID, unchanged). The old outreach TRACKER tab (the hidden
# "Outreach Updates") and the phase-1 cadence rules that ran on it are RETIRED:
# nothing evaluates against them and no proactive output is wired to them.
#
# THIS ONE TAB IS FOUND BY NAME, NOT BY HEADER SIGNATURE. That is deliberate and
# it is the opposite of how every other tab is found. The retired tracker tab
# carries near-identical columns, so a signature match would cheerfully re-adopt
# it as the canonical tab and undo the move. Naming the tab is what makes the
# retirement real. Its COLUMNS are still discovered dynamically at parse time,
# and the full discovered schema of every tab is logged at startup.
#
# EVERY OTHER TAB is still recognised by a small signature of headers only that
# tab has, and the tab NAME that matched each role is logged under [gtm.roles].
#
#   MASTER    "Response Status" + "Intro Sent" + "Meeting Done"
#             (live: "Master Data") — status only; aggregate answers and the
#             weekly funnel.
#   PIPELINE  "Lead Stage" + "Estimated Value (INR)"  (live: "Lead Master Sheet")
#   FUNNEL    "Vertical / Stage"  (live: "Sales Funnel - March-June 2026") —
#             the funnel DEFINITION: Contacted -> Connected -> Intro Sent ->
#             Positive (P/Y) -> Meeting Done -> Assets Shared.
#   RESEARCHER LINES  "Outreach Line - Researchers" + "Dates"
#             (live: "Master Pipeline")
#
# RE-POINTING THE BOT AT A DIFFERENT SHEET IS AN ENV CHANGE PLUS A RESTART. No
# code edit, no migration:
#     GTM_SHEET_ORIGINAL_ID     which spreadsheet
#     GTM_POCS_TAB_TITLES       which tab is canonical
#     GTM_COLUMN_MAP            which header means which role
#     GTM_DELIVERABLES_TAB_TITLES / GTM_PIPELINE_TAB_TITLES /
#     GTM_PACKAGES_TAB_TITLES / GTM_EVENTS_TAB_TITLES /
#     GTM_GOALS_TAB_TITLES      the five read-only context tabs, each by name
#     RESTRICTED_COLUMN_RANGES  which columns the bot may never write
#     SALES_DEFAULT_OWNER_ID    who the lines are addressed to
# -----------------------------------------------------------------------------

# THE NAME OF THE CANONICAL TAB, comma-separated, matched case- and
# punctuation-insensitively. The first tab whose title matches wins, hidden or
# not. If the tab is renamed in the sheet, change this and restart — until then
# the bot logs "no tab named ..." at ERROR and every proactive feature has
# nothing to run against, which is the honest failure rather than a silent one.

GTM_POCS_TAB_TITLES=Outreach PoCs,Outreach POCs,Outreach PoC,Outreach Pocs
# -----------------------------------------------------------------------------
# THE READ-ONLY CONTEXT TABS — four more, all found BY NAME
#
# Each is a comma-separated list of candidate titles, matched case-, space- and
# punctuation-insensitively. The first setting whose title matches claims the
# tab, and a tab named by two settings is logged as a conflict rather than
# resolved silently.
#
# WHY NAMES AND NOT SIGNATURES. A signature describes a SHAPE, and this playbook
# has several tabs of each shape: the deliverables checklist and the packages
# tab are both "a list of things with a status"; the events tab and the
# goal-setting tab are both "a name and a date". A signature would have to
# choose between them on a scoring margin, and the wrong choice is SILENT — the
# bot reads the goals tab as the events list and reminds nobody about anything.
#
# ALL FOUR ARE READ-ONLY. No write path can address them: every write is planned
# against the canonical tab's writable window and nothing else. Their full
# discovered schemas are logged at startup under [gtm.schema].
#
# AN EMPTY VALUE IS AN ERROR, not a way to switch a tab off. A name-discovered
# tab with no name to look for is simply not found, and everything built on it
# goes quiet without saying why — so the bot logs it at ERROR instead.
# -----------------------------------------------------------------------------

# "Deliverables Checklist": Sr No · Action Item · Functional Dependency ·
# Priority · Tentative Deadline · Timelines · Link/Destination · Status ·
# Reminder Freq.
#
# ITS DEADLINES CARRY NO YEAR ("25-Sep", "3-Oct") and are read as the NEXT
# occurrence from today. That is the only reading that is right in every month:
# assuming the current year puts every January deadline eleven months in the
# past the moment February arrives, and reports the whole checklist as overdue.
# The cost of the rule is at the other end — a deadline that passed a few days
# ago reads as next year's, so a date in the recent past is worth a human eye.
GTM_DELIVERABLES_TAB_TITLES=Deliverables Checklist,Deliverable Checklist,Deliverables,Checklist

# "Master Pipeline": Sr no. · Company · Industry · Geography · Approx. Funding ·
# Outreach Line - Researchers · Dates. One researcher-led outreach line per
# company — what the bot quotes when asked what the opening line for an org is
# meant to be.
GTM_PIPELINE_TAB_TITLES=Master Pipeline,Master pipeline,Pipeline Master,Master Pipeline Sheet

# "Sales Packages": Package · Name · Purpose · Use Case · Size · Audio Files ·
# Image Files · JSONL Output · Pulse_Product Doc · % Completion · Ready? ·
# Status. What can actually be SOLD today, and how finished each package is.
#
# A BLANK "Ready?" READS AS NO. A package nobody has marked ready is a package
# nobody has said is ready, and the two mistakes do not cost the same: calling a
# finished package unready costs one question, and offering a prospect a
# half-built one costs a promise somebody else has to keep.
GTM_PACKAGES_TAB_TITLES=Sales Packages,Sales Package,Packages,Package List

# "Q4-OND2026-Goal Setting": the strategy-motions table and the goals table.
# READ-ONLY CONTEXT FOR ANSWERS AND NOTHING ELSE — no rule evaluates it and
# nothing proactive fires off it. It is there so "what is this quarter committed
# to" has an answer the bot can cite instead of infer.
GTM_GOALS_TAB_TITLES=Q4-OND2026-Goal Setting,Q4 OND2026 Goal Setting,Goal Setting,Goals,Q4 Goal Setting

# An optional NAME hint for the master tab, comma-separated, matched case- and
# punctuation-insensitively.
#
# IT IS A HINT, NOT AN AUTHORITY. A tab named here is still only read as the
# master if it carries the master signature, and naming a tab here can never
# reach the canonical Outreach PoCs tab — that one is claimed by name before any
# signature is scored. Leaving it empty is fine.
GTM_MASTER_TAB_TITLES=Master data,Master Data,Master-data,Masterdata

# Read tabs the spreadsheet marks HIDDEN. LEAVE THIS ON unless a hidden tab is
# actively causing trouble: the canonical tab is taken by NAME whether it is
# hidden or not, and turning this off would hide it if it ever is. gspread
# returns hidden worksheets like any other, and they are logged as hidden rather
# than silently included.
GTM_READ_HIDDEN_TABS=true

# Log the FULL discovered schema at startup: every tab, hidden or not,
# recognised or not, with its complete header list and its mapped roles. This is
# how a column rename is diagnosed in one log read instead of a debugging
# session, so it defaults ON.
GTM_LOG_FULL_SCHEMA=true

# THE COLOUR-CODING CHECK. A status is sometimes conveyed by CELL COLOUR. The
# bot reads cell VALUES ONLY — it cannot see fills — so a colour-coded column
# looks empty to every rule that reads it, silently. At startup the bot warns,
# BY NAME, about any mapped column that is filled on no more than RATIO of at
# least MIN_ROWS rows:
#   "the meeting_date column ('Meeting Date') is filled on 9 of 886 rows. It MAY
#    BE COLOR-CODED ... it needs a text value in each cell."
CADENCE_EMPTY_COLUMN_MIN_ROWS=10
CADENCE_EMPTY_COLUMN_RATIO=0.05


# -----------------------------------------------------------------------------
# RESTRICTED COLUMN BANDS — where the bot may NEVER write
#
# Comma-separated A1 column ranges ("A:I,S:X") or bare single columns ("A,C").
# Resolved to column indexes once at startup and DENIED to every write path in
# the code — the append of the bot's own deadline column and the single-cell
# write inside it, which together are the entire write surface of this bot.
#
# THIS IS A WRITE LOCK, NOT A READ LOCK. Reading stays completely unrestricted:
# the bot parses, quotes and answers questions about every column in the tab.
# The bands exist because the sheet's left-hand identity block and its
# right-hand formula block are maintained by people and by formulas the bot
# cannot see, and a bot writing into either would destroy work silently.
#
# THE CHECK FAILS CLOSED. A column index that cannot be read as a number is
# treated as restricted — "I could not work out which column this is" has never
# been a reason to write to it.
#
# WHAT TO LOOK FOR AT STARTUP. The bot logs the NAMED columns that fall inside
# the writable window BETWEEN the bands. On the current tab that is exactly
# columns J through R, and all nine of them:
#   [gtm.window] 'Outreach PoCs': restricted A:I, S:X (NEVER written).
#   Writable window J:R holds 9 named column(s): J='First Contact'
#   [first_contact], K='First Contact Type' [first_contact_type],
#   L='First Contact Date' [first_contact_date], M='Sid - LI Addition'
#   [sid_li_added], N='LI Connected Date' [li_connected_date], O='LI DM Sent'
#   [li_dm_sent], P='LI DM Date' [li_dm_date], Q='Meeting Date' [meeting_date],
#   R='Meeting Status' [meeting_status]
#
# A:I IS THE IDENTITY BLOCK (Sr No through LI Url) and S:X IS THE COMMERCIAL
# BLOCK (Next Steps/Notes through Deal Status). Both are maintained by people;
# the nine columns between them are the outreach progress the bot tracks. That
# is why these bands and not others, and why the default should not be widened
# without deciding who owns the columns it would open up.
#
# Read that line after any change to the sheet's columns. The bands are stated
# as LETTERS and columns move — insert one column on the left and every band
# now covers something else. That log line is the only thing that makes the
# drift visible before a write lands in the wrong place.
#
# A CONSEQUENCE WORTH KNOWING: the bot appends its "Next Deadline (bot)" column
# at the far right of the tab. If the far right is inside the right-hand band,
# the append is REFUSED and the refusal is reported — the deadline is still set,
# stored in SQLite and announced, it just isn't mirrored to the sheet. That is
# the intended trade: a locked column stays locked.
RESTRICTED_COLUMN_RANGES=A:I,S:X


# -----------------------------------------------------------------------------
# ROW ACTIVATION — which rows the bot may raise unprompted
#
# THERE IS NO ENV VAR HERE ON PURPOSE, and this block is why.
#
# THE RULE: a row of the canonical "Outreach PoCs" tab is ACTIVE only when a
# FIRST-CONTACT DATE or a CONNECTION DATE is present in it. An INACTIVE row is
# invisible to every PROACTIVE feature — never mentioned, never chased, never
# counted in the digest, the hygiene flags, the weekly funnel, the
# outreach-vs-plan check or the meeting layer's company list.
#
# IT IS NOT A SWITCH because it is not a preference. The tab is a working list
# of people somebody might contact, not a list of people somebody has contacted;
# most of it is research. Chasing those rows is not chasing outreach, and it
# buries the handful of rows actually in flight. Turning the rule off would not
# give you more signal, it would give you the sheet back.
#
# READING IS UNAFFECTED. Ask about an inactive row by name and the bot answers
# in full, including "we have no record of contacting them" — the rule governs
# what it brings up on its own initiative, not what it is allowed to know.
#
# THE ONE EXCEPTION is an explicit request: "set connection reminders for the
# others at <org>" activates those rows by name. That activation is persisted in
# SQLite (the row_activations table, keyed on company+PoC rather than on a sheet
# row number that moves when somebody sorts the tab) so it survives a restart.
#
# HOW TO CHECK IT: ask the bot "sheet status". It returns the tab name, the
# total rows, the ACTIVE rows and the writable-window columns. "886 rows, 12
# active" is the answer to "why has the digest gone quiet".


# -----------------------------------------------------------------------------
# THE CADENCE — the phase-1 rules (a-j) are RETIRED
#
# WHAT WAS REMOVED, and with it every threshold that tuned it:
#   (a) stale_followup      FOLLOWUP_STALE_DAYS
#   (b) intro_pending       —
#   (c) start_interacting   CONNECT_REMINDER_DAYS, CONNECT_REMINDER_MAX_DAYS
#                           (the cold ceiling, the cold summary, "cold list")
#   (d) alt_channel         ALT_CHANNEL_AT
#   (e) unresponsive        UNRESPONSIVE_AT
#   (f) lock_meeting        —
#   (g) try_another_poc     —
#   (h) meeting_soon        (this fed the meeting-prep briefs, now unwired)
#   (i) post_meeting        —
#   (j) nextstep_stall      NEXTSTEP_STALL_DAYS
#   the UPDATE-TRACKER fill-in asks          UPDATE_TRACKER_MAX
#   the master/tracker cross-check           CADENCE_CROSSCHECK_ENABLED, _MAX
#
# EVERY ONE OF THOSE VARIABLES IS GONE FROM config.py, and every one of them is
# listed with its replacement in the RETIRED block at the BOTTOM OF THIS FILE.
# Setting one now does nothing at all — a threshold left behind for a rule that
# no longer exists is a lie in the config, and somebody would eventually tune it
# and wonder why nothing changed.
#
# WHAT SURVIVES: the SHEET-HEALTH flags, which are a property of the spreadsheet
# rather than of any rule, and the plumbing (rejection markers, the caps, the
# owner resolution) that a phase-2 rule set will need.
#
# NO PHASE-2 RULE SET IS DEFINED YET, so the digest's five cadence sections
# carry sheet-health lines and nothing else. That is deliberate and visible: the
# startup [sheet.world] report and the daily [cadence] log line both say what
# was considered, so "quiet" can be told apart from "broken".
# -----------------------------------------------------------------------------

# Master switch. Off = the cadence sections are simply absent from the digest
# and nothing else changes.
CADENCE_ENABLED=true

# Cell values that mark a row REJECTED, on top of the Response column saying so
# ("N", "N - Rejected", "No" are always a rejection). A rejected row is excluded
# from every proactive feature — never chased, revisited offline by humans.
# Matched as whole phrases, case-insensitively, across every cell of the row.
#
# THIS IS A SECOND, NARROWER GATE THAN ACTIVATION. Activation asks "has this
# ever started"; rejection asks "was it deliberately stopped". They are reported
# separately because "we never contacted them" and "they said no" are not the
# same answer to any question.
CADENCE_REJECTED_MARKERS=rejected,not interested,disqualified,do not contact,dnc,closed lost,lost,dropped,drop,blacklist,blacklisted

# WHO A PROACTIVE LINE IS ADDRESSED TO: SALES_DEFAULT_OWNER_ID, in the DEADLINE
# AUTHORITY block further down. It is set once and used by everything that
# addresses a line to a person.

# THE URGENT ITEMS ARE NEVER TRUNCATED, and they have their own ceiling. A HARD
# CEILING, NOT A TARGET: it exists only so a broken sheet cannot produce a
# thousand-line message. If it is ever actually hit the bot logs a warning, and
# that is a bug to look at rather than a number to raise.
URGENT_MAX=25

# How many NON-URGENT items the digest carries; the urgent items above are
# counted separately and are never cut by this. Anything past the cap is counted
# in one closing line rather than silently dropped.
DIGEST_MAX_ITEMS=15

# THE SHEET-HEALTH FLAGS: broken formulas (#REF! / #N/A / #VALUE!, which the bot
# reads as EMPTY and which would otherwise be invisible), master rows whose
# cells hold values from the wrong column's vocabulary, and response values
# outside the known set.
#
# ONE LINE EACH, AND DEDUPED UNTIL FIXED. A flag whose signature hasn't changed
# since it was last reported is not repeated — a daily reminder about a #REF!
# everybody already knows about is exactly the drip that gets a digest muted.
# The dedup lives in SQLite (quality_flags).
#
# The row-level checks run on ACTIVE rows only; broken formulas are counted
# across the whole tab, because a broken formula belongs to the tab rather than
# to a row's readiness and whoever fixes it needs the full count.
CADENCE_DATA_QUALITY_ENABLED=true

# The on-demand uncapped list is bounded too: a Discord reply has a size limit,
# and 400 lines of cadence is not an answer.
CADENCE_FULL_LIST_MAX=200


# -----------------------------------------------------------------------------
# THE NEXT-ACTION STATE MACHINE — one action per row, and it sends NOTHING
#
# For every ACTIVE row the engine produces EXACTLY ONE next action — a type, an
# owner, a due date and a priority — or nothing at all, with a reason. It
# REPLACES the old per-row "what next" logic: the three row-hygiene flags
# (HOT / STALLED / DEAD-DEAL) and the ad-hoc deadline kinds that stood in for a
# cadence. Those answered "is something wrong with this row" and could give two
# answers at once; this answers "what does somebody do about it next".
#
# THE TRIGGERS ARE EVALUATED IN A FIXED ORDER AND THE FIRST MATCH WINS. That
# order is the product decision and it lives in nextaction.py:
#
#   0  stopped            closure 0% / Dead / Unresponsive / Won / Lost -> STOP
#   1  snoozed            a live snooze -> silent until its date
#   2  meeting_proposal   any positive/replied row            (band: override)
#   3  scheduled_reminder a one-off somebody asked for        (band: meetings)
#   4  quote_chase        stage Demo, no movement, +N days    (band: meetings)
#   5  progress_check     DM sent + N days                    (band: follow-ups)
#   6  dm_check           connected + N days, still no DM     (band: follow-ups)
#   7  dm_sent_check      connected + N hours, no DM          (band: follow-ups)
#   8  mark_unresponsive  silent touches >= N                 (band: follow-ups)
#   9  channel_switch     silent touches >= N                 (band: follow-ups)
#  10  pulse_check        deal On Hold                        (band: slow lane)
#  11  followup           the lane cadence off the last touch (band: varies)
#
# WITHIN A DAY the queue is ordered: positive overrides > meetings and demo
# chases > 7-day follow-ups > slow lane; oldest due date first inside a band.
#
# IT HAS NO SEND PATH. The engine is pure computation and is NOT wired into the
# daily digest. Read it by asking the bot "cadence preview", or in the startup
# log under [nextaction.preview]. That makes it safe to deploy with the digest
# kill switch off — which is exactly what it was built for.
# -----------------------------------------------------------------------------

# Master switch. Off = no queue is computed at all, and "cadence preview" SAYS
# so rather than returning an empty list — "nothing to do" and "I did not look"
# are different answers and only one of them is good news.
NEXT_ACTION_ENABLED=true

# -----------------------------------------------------------------------------
# THE TWELVE RULES
#
# WHAT THE BOT SAYS ON ITS OWN INITIATIVE is the twelve rules in
# `bot_rules.yaml` — the machine copy of the "Bot Rules" tab of
# *Sales Bot_membrane*. That file decides WHICH rules exist, WHICH DAY each
# runs, HOW MANY items one post may carry, WHERE it goes and whether it counts
# against the daily cap. Editing it changes behaviour with a RESTART AND NO
# CODE CHANGE, which is the point of it being a file.
#
# WHAT LIVES HERE IS THE ARITHMETIC EACH RULE NEEDS. A setting below answers
# "how long is too long"; the FILE answers "does this rule run today". Keeping
# those apart is what makes a schedule change an edit rather than a deploy.
#
# THE THRESHOLDS THAT TUNED THE PLAN-V2 TRIGGERS ARE RETIRED with the triggers
# themselves — FOLLOWUP_GRACE_DAYS, CONNECT_DM_CHECK_HOURS, SLOW_LANE_DAYS,
# ON_HOLD_PULSE_DAYS, CHANNEL_SWITCH_AT, UNRESPONSIVE_SUGGEST_AT and the rest.
# They are listed ONCE, with what replaced each, in the RETIRED block at the
# BOTTOM OF THIS FILE. Setting any of them does nothing.
# -----------------------------------------------------------------------------

# WHERE THE RULES LIVE. Read ONCE at startup, not per tick: a file that reloaded
# itself would let two messages in one day run under two different schedules,
# and the log line explaining the first would not explain the second.
#
# A MISSING OR BROKEN FILE LOADS **NO** RULES, not some of them, and says so at
# ERROR. A partially-applied schedule would look healthy while silently missing
# a rule nobody noticed.
BOT_RULES_FILE=./bot_rules.yaml

# R3 — EVENTS, EVERY OTHER WEDNESDAY. The anchor is the first Wednesday the rule
# fires on; every second Wednesday after it is a run day. An anchor DATE rather
# than "odd ISO weeks" because the team picked a date, and an ISO-week parity
# rule silently flips its meaning in any year with 53 weeks.
EVENTS_ANCHOR_DATE=2026-09-23

# R4 — DELIVERABLES (Mondays). An item is chased when its tentative deadline is
# within this many days OR has already passed. Deadlines on that tab carry no
# year ("25-Sep") and are read as the NEXT occurrence.
DELIVERABLE_NEAR_DAYS=3

# R4 — who a deliverable is addressed to when its Functional Dependency cell is
# blank. Blank is common, and it is not the same as unowned: a deliverable
# nobody is addressed about is a deliverable nobody chases.
DELIVERABLE_DEFAULT_OWNER=Vaishnavi

# R4 — which Priority values count as P1, and which Status values mean DONE.
# Everything not on the done list, blank included, is still open. That is the
# safe direction: chasing a finished item costs one correction, and skipping an
# unfinished one costs the deadline.
DELIVERABLE_P1_MARKERS=p1,p 1,1,high,highest,critical,urgent
DELIVERABLE_DONE_MARKERS=done,completed,complete,closed,shipped,live,finished,delivered

# R5 — PROSPECTS (Tue, Thu). Two companies or universities a week, in SHEET
# ORDER, and the bot stays with one until every contact on it has a first
# contact recorded. Moving on early is how a company ends up half-contacted
# forever, so the companies in flight are remembered against the ISO week.
PROSPECT_COMPANIES_PER_WEEK=2

# R5 — after this many posts carrying the SAME contact with NOTHING CHANGED, the
# bot asks whether to skip them instead of naming them a fourth time. A changed
# row resets the count: somebody who updated it has acted, and a counter that
# kept climbing through their update would ask to skip a contact who is moving.
PROSPECT_REPEAT_ASK_AT=3

# R5 — the role order within a company, best first. A contact whose designation
# matches an earlier phrase is offered before one matching a later phrase.
# Anything matching NONE sorts last, in sheet order — an unrecognised title is
# not evidence of seniority in either direction, so it waits rather than
# jumping the queue or being dropped.
PROSPECT_ROLE_ORDER=founder,co-founder,cofounder,ceo,cto,coo,cpo,chief executive,chief technology,chief scientist,chief,vp,head of research,research lead,principal researcher,research scientist,researcher,professor,phd,product

# R6 — LinkedIn connected, no DM after this many days (Tue, Fri).
LI_NO_DM_DAYS=3

# R7 — DM sent, no meeting after this many days (Mondays). The item shows days
# since the DM and the last note logged, because those two are what a person
# needs to decide whether to chase again or leave it.
DM_NO_MEETING_DAYS=7

# R8 — MEETING PREP. Which days before the meeting each touch fires, and the IST
# time the day-of touch goes at. ANCHORED TO THE MEETING, not to a weekday.
#
# TOUCHES ALREADY IN THE PAST ARE SKIPPED: a meeting booked with three days'
# notice gets the 3-day and day-of touches and never a late 5-day one. A
# reschedule re-anchors every touch on the new date, at no cost — the meeting
# date is read fresh on every run.
MEETING_PREP_DAYS_BEFORE=5,3
MEETING_DAYOF_TIME=10:00

# R9 — MEETING DONE, NO NEXT STEPS. First ask this many days after the meeting,
# then every this-many days again.
MEETING_FOLLOWUP_AFTER_DAYS=3
MEETING_FOLLOWUP_EVERY_DAYS=3

# R9 — the ladder, as destinations in order: one channel post, then two DMs,
# then one escalation to Sid, then STOP. Running off the end stops the chase
# PERMANENTLY, and that end is the point — a follow-up loop with no last rung is
# the thing that gets a bot muted.
#
# WITH SALES_DMS_ENABLED OFF, a rung resolving to dm or escalation is still
# computed, still ranked and still POSTED — in the channel, addressed to the
# owner, or to ESCALATION_ADDRESSEE for the escalation rung. Dropping it would
# hide a rule that is supposed to be running.
#
# THE MESSAGE ITSELF SAYS NOTHING ABOUT A DM. It reads as an ordinary channel
# post, because "this would have been a DM" is a fact about the bot's plumbing
# and the reader is being asked to do something about a meeting. The fallback is
# recorded where operators look for it — a [dm] fallback-to-channel line in the
# log, and the audit trail — and nowhere else.
MEETING_FOLLOWUP_LADDER=channel,dm,dm,escalation

# R10 — CLOSURE SUPPORT (Mondays). Deals STRICTLY ABOVE this closure probability,
# at deal / demo / quote stage. EXACTLY 50 IS EXCLUDED: "above 50" is the rule
# as written, and a boundary a bot decides for itself is a boundary nobody
# agreed to.
CLOSURE_SUPPORT_MIN=50
CLOSURE_SUPPORT_STAGES=deal,demo,quote,demo done,quote sent,proposal,negotiation

# R11 — NEW COMPANY IN THE MASTER PIPELINE. This many WORKING days after a
# company first appears. There is NO created-date column on that tab, so
# "appears" means "in today's names and not in yesterday's snapshot" — the
# snapshot lives in SQLite and is taken by the CALLER, not the engine, so that
# running a preview cannot consume the newness it is supposed to be showing.
#
# THE FIRST EVER RUN REPORTS NOTHING. On an empty table every company looks new,
# and announcing the whole tab would be a memorable first impression.
NEW_COMPANY_AFTER_WORKING_DAYS=1

# R11 — how long a company stays eligible after it appears. Without a window a
# snapshot gap (the bot was down for a week) would dump every company added in
# that gap into one post.
NEW_COMPANY_WINDOW_DAYS=7

# (10) STOP, FOREVER. Closure values that end a row: no next action is ever
# produced for it again by any trigger, the priority override included. A won
# deal does not need a meeting proposal and a dead one does not need a
# follow-up. Matched as whole phrases, case-insensitively, against the closure
# and deal-status cells.
#
# A closure of exactly 0% also stops the row, handled numerically. A BLANK
# closure cell does NOT — that distinction matters, because most rows have never
# had the column filled in and reading a blank as 0% would silence the sheet.
CLOSURE_STOP_MARKERS=dead,unresponsive,won,lost,closed won,closed lost,closed-won,closed-lost,not interested,do not contact,dnc

# What the deal-status cell says when a deal is parked, and when it is live.
# Phrase lists so a sheet writing "Paused" instead of "On Hold" is an env change
# rather than a code change.
DEAL_ON_HOLD_MARKERS=on hold,onhold,on-hold,paused,parked,deferred
DEAL_IN_PROGRESS_MARKERS=in progress,inprogress,in-progress,active,live,ongoing,negotiating,proposal sent

# What the prospect/stage cell says when a demo has happened. The quote chase
# fires off this. Read from the prospect column, falling back to deal status —
# sheets in the wild put the stage in whichever column is nearer to hand.
PROSPECT_DEMO_MARKERS=demo,demo done,demo given,demo completed,demo scheduled,demoed

# What the first-contact-type cell says when the first contact WAS by email.
# THE ONE TYPE-AWARE RULE IN THE ENGINE: the progress check drops its "ask for
# an email address or a phone number" line when this matches. Asking a prospect
# you emailed for their email address is the kind of line that gets a bot
# switched off. A blank or unreadable type INCLUDES the ask, which is the safe
# direction.
EMAIL_CONTACT_TYPES=email,e-mail,mail,cold email,emailer

# NO DUE DATE EVER LANDS ON A SATURDAY OR A SUNDAY — every computed date is
# shifted forward to the Monday.
#
# THE ONE EXCEPTION IS AN EXPLICITLY SCHEDULED REMINDER, a one-off somebody
# asked for at a specific time ("remind me about Acme on Saturday morning").
# Those are stored in the scheduled_reminders table and keep their exact date: a
# person asking for their own Saturday has decided about their own Saturday, and
# a bot that "corrects" it to Monday has thrown the instruction away silently.
#
# Turning this off is supported and almost certainly wrong: a Saturday due date
# is read on Monday anyway, two days late, and looks like the bot cannot read a
# calendar.
NEXT_ACTION_WEEKEND_SHIFT=true

# How many lines "cadence preview" prints. It is an answer in a Discord message
# and a message has a size limit; the count of what was cut is always reported
# alongside, so the cap can never read as "that was all of it".
NEXT_ACTION_PREVIEW_MAX=60


# -----------------------------------------------------------------------------
# MEETING-PREP BRIEFS — currently DORMANT
#
# A brief is company + PoC, the mapped researcher row WITH its caveats, the
# matching pitch from the positioning matrix, and anything on file from past
# meeting notes. Deduped in SQLite so it is written once per meeting rather than
# once a day until the meeting happens.
#
# NOTHING TRIGGERS ONE TODAY. The brief was selected by phase-1 rule (h) — "a
# meeting inside MEETING_PREP_DAYS" — and that rule is retired with the rest of
# the phase-1 set, so no meeting is chosen and the MEETING PREP section of the
# digest is always empty. prep.py is unchanged and still builds a brief; what is
# gone is the proactive trigger, and re-wiring it is a phase-2 rule.
#
# The settings below are kept, and so is the SQLite dedup record: throwing that
# away would mean re-briefing every meeting already covered the day a phase-2
# rule turns this back on.
# -----------------------------------------------------------------------------

CADENCE_PREP_BRIEFS_ENABLED=true

# How many briefs one digest may carry. Three meetings on one day is a good day;
# ten is a formatting problem.
CADENCE_PREP_MAX_PER_DIGEST=3

# How far back a brief looks for a meeting note about the same company.
CADENCE_PREP_NOTES_DAYS=120

# THE BRIEF CARRIES NO WEB RESEARCH, and says so. That is now a statement about
# THE BRIEF, not about the bot: web search exists (see WEB_SEARCH_ENABLED) and
# the drip's rules use it, but a meeting-prep brief is still built only from the
# sheets and the meeting notes.
#
# The section stays because a silent gap reads as "there was nothing to find",
# and because nothing external is ever invented to fill it. Leaving this on is
# the honest setting; turning it off only HIDES the notice, it does not add
# research to the brief.
CADENCE_PREP_NOTE_NO_WEB=true


# -----------------------------------------------------------------------------
# RESEARCHER / BUYER MAPPING SHEET — the third source, STRICTLY READ-ONLY
#
# "membrane.social - Researcher Buyer Mapping". Where the GTM Playbook says which
# ACCOUNTS we are working, this says which PEOPLE to pitch inside them: the ICP
# lane they sit in, the tier, the evidence behind it, the hook to open with — and
# who must not be pitched at all.
#
# THE BOT NEVER WRITES HERE, and that is enforced in code rather than promised in
# a comment. Three independent locks:
#   1. mapping_sheet.py has NO write method of any kind.
#   2. Its client uses the READ-ONLY Sheets scope (spreadsheets.readonly), so the
#      token itself is refused by Google on any write.
#   3. Every write path in gtm_sheet.py checks config.is_read_only_sheet_id() and
#      refuses this id — so even setting GTM_SHEET_ORIGINAL_ID to this sheet
#      cannot produce a write. config.validate() also forces
#      SHEET_WRITES_ENABLED=false in that case, and says so loudly.
# Share it as VIEWER. Editor is not needed and would only widen the blast radius.
#
# THE SHEET'S OWN RULES ARE LOADED AS BEHAVIOUR, not just read as data. The
# "Mapping _Legend" tab states them and the bot enforces them on every answer:
#   - ICP lanes a/b/c/d and the T1/T2/T3 tier definitions are read FROM the
#     legend, so re-wording them there changes how the bot answers.
#   - Confidence (evidence quality) and Tier (buyer fit) are INDEPENDENT and are
#     always quoted separately.
#   - The legend's refresh rule ("re-verify any row older than ~6 weeks") is read
#     from the sheet and measured against TODAY — never hardcoded — so rows earn
#     a "re-verify role before outreach" caveat on their own as time passes.
#   - The Edge Map's DEPARTURES row is a do-not-pitch list: anyone on it is never
#     recommended, and the answer says where they went.
#   - Non-buyers (competitors / channel partners) and budget-gate failures are
#     read out of the legend's Known gaps and are never pitch targets.
#   - Each row's Watch-outs column is stated alongside its hook.
#
# Tabs are discovered dynamically (legend, researcher mapping, org coverage, edge
# map); anything else in the workbook is logged once and ignored.
# -----------------------------------------------------------------------------

# The mapping spreadsheet id (the long string in the URL between /d/ and /edit).
# Defaults to the real sheet, so it normally needs no setting. Unset it and the
# researcher-mapping source reports awaiting-access — no "who do we pitch at X"
# question can be answered, and the bot says so rather than guessing a name.
GTM_MAPPING_SHEET_ID=1YwNj2R3OoGhn3bvFIZmGBS9s9Fl316Mp7JsACxrHM2Q

# Override the header→role mapping for the MAPPING sheet when a tab's wording is
# genuinely ambiguous. Same shape as GTM_COLUMN_MAP, but keyed by the mapping tab
# kinds: mapping_legend / researcher_mapping / org_coverage / edge_map. Headers
# are auto-discovered, so this is only for when auto-detection picks wrong.
GTM_MAPPING_COLUMN_MAP=


# -----------------------------------------------------------------------------
# DEADLINE AUTHORITY
#
# Kushal-sanctioned: asked about a deadline that doesn't exist, the bot SETS one
# rather than asking which date you'd like. It announces it in channel with the
# rule it used and invites anyone to change it — a default someone can push back
# on beats an empty cell nobody owns.
#
# The date comes from the strategy doc's cadence when that doc is readable;
# otherwise from these, counted in WORKING DAYS, IST.
# -----------------------------------------------------------------------------

# Working days after the last touch before the next outreach follow-up is due.
OUTREACH_FOLLOWUP_DAYS=3
# Working days to wait on a reply before chasing it.
REPLY_CHASE_DAYS=2
# Working days before a booked meeting that prep is due.
# Raised from 1 to 4 for phase 1. This ALSO defines the cadence's meeting
# window: a meeting within this many days ranks URGENT in the digest and is what
# triggers its one prep brief. A brief that lands the morning of the meeting is
# too late to act on.
MEETING_PREP_DAYS=4

# WHO EVERY CADENCE LINE IS ADDRESSED TO — Vaishnavi's Discord id.
#
# THE TRACKER HAS NO OWNER COLUMN. Every row is worked by the same person today,
# so a cadence line resolves its owner in two steps:
#   1. the row's own owner cell, IF a column ever appears (or GTM_COLUMN_MAP
#      names one: {"outreach_pocs":{"owner":"Owned By"}}). It holds a NAME,
#      resolved against ROSTER_DISPLAY_NAMES / TEAM_ROSTER_IDS;
#   2. this id.
#
# It must ALSO be in TEAM_ROSTER_IDS to be @-mentioned — the roster is the only
# thing that authorises a mention, and an id that isn't on it gets named in
# plain text instead. Unset means cadence lines go out under the
# DEADLINE_NOTIFY_IDS group line, which is worse but never wrong.
SALES_DEFAULT_OWNER_ID=

# Discord ids tagged on every deadline announcement — the "shout to change"
# audience. Set this to Kushal and Vaishnavi.
# They must ALSO appear in TEAM_ROSTER_IDS: the roster is the only thing that
# authorises a mention, so an id missing from it is named in plain text instead.
DEADLINE_NOTIFY_IDS=

# Who the ESCALATIONS section of the daily digest is addressed to, once
# COS_NUDGE_MAX_ATTEMPTS is spent on an item (Kushal). Also needs to be on the
# roster to be pinged. Escalated items stay in that section until they are
# resolved; the bot stops chasing their owner.
# -----------------------------------------------------------------------------
# PERMISSION BEFORE EVERY WRITE
#
# THE GLOBAL RULE FROM THE WORKBOOK: the bot never writes a cell straight from a
# reply. It posts the exact change it proposes, in the sheet's own column names,
# and waits for a yes.
#
#     "Shall I set Meeting Date to 24 Sep for Sahaj (Wispr Flow)? Reply yes."
#
# WHAT THIS COSTS AND WHY IT IS WORTH IT. The old loop was one message: somebody
# said "met Sahaj today" and the cell was written by the time they read the echo.
# That is faster, and fine right up until the extractor is wrong about which
# row, column or date — and then a person's data has been overwritten by a
# machine nobody told to do it. The undo window catches that only if somebody
# reads the echo; a proposal catches it before it happens.
#
# ANYBODY MAY TELL THE BOT SOMETHING and it will propose the change. Only an
# approver's yes applies it; anybody else saying yes gets a polite no naming who
# can, and the proposal stays open.
SALES_APPROVER_IDS=<REQUIRED: the ids who may approve a sheet write>

# WHOSE ANSWER WINS WHEN TWO APPROVERS DISAGREE. Strategy section 8: "Sid's word
# is final." This person's answer outranks everyone else's whether it came first
# or last, which is why every vote is stored rather than the first one acted on
# — Vaishnavi saying yes at 14:02 and Sid saying no at 14:09 must not have
# written anything at 14:02.
#
# 0/unset means no tie-break and the FIRST approver to answer decides. That is
# the honest degraded behaviour, it is logged at startup, and the bot says so in
# its own explanation of the decision.
SALES_FINAL_SAY_ID=<REQUIRED: the id whose vote breaks a tie (Sid)>

# NO REPLY IS ALSO AN ANSWER, EVENTUALLY. One nudge this many WORKING days after
# the proposal (a proposal made on Friday afternoon is not stale on Saturday),
# then it is dropped and logged. Two nudges is nagging; a proposal that never
# expires is a queue of half-decisions with no visible end.
# WORKING days, not calendar days: a proposal made on Friday afternoon is not
# stale on Saturday, and dropping it on Monday because two calendar days passed
# over a weekend nobody worked would be the bot punishing people for the weekend.
#
# THE SWEEP RUNS ONCE A WORKING DAY, IN THE FIRST DRIP SLOT, and posts ONE
# combined message however many proposals are waiting — "A few things still
# waiting for a yes: ...". Four separate posts about the same kind of thing is
# four interruptions; one list is a glance.
#
# IT DOES NOT COUNT AGAINST THE DAILY CAP. A day that spent all its slots on
# rules and therefore never mentioned four pending approvals would be a day the
# approvals queue grew invisibly.
#
# NOTHING IS SAID ON A DAY WITH NOTHING PENDING. A daily "no approvals
# outstanding" post is the fastest way to teach a team to skim.
PROPOSAL_NUDGE_AFTER_DAYS=1

# ...AND HOW LONG AFTER THE NUDGE BEFORE IT IS DROPPED. ONE nudge, then the
# proposal is closed, recorded in audit.jsonl, and never mentioned again.
PROPOSAL_DROP_AFTER_DAYS=1

# The old names, kept as aliases so an existing .env keeps working. The new
# names win when both are set — and both pairs ARE set here, to the same
# numbers, so change a pair together or edit only the new name above.
PROPOSAL_NUDGE_AFTER_WORKING_DAYS=1
PROPOSAL_DROP_AFTER_WORKING_DAYS=1

# -----------------------------------------------------------------------------
# ROW ADDITIONS
#
# R2 (news-company screen), R3 (events) and R11 (new pipeline company) may each
# PROPOSE a new row. An approver's yes appends it; nothing is appended silently.
SHEET_ROW_ADDITIONS_ENABLED=true

# Which tabs may receive an appended row. A tab not named here is refused even
# with an approval — "which tabs may grow" is a decision about the shape of the
# workbook, not about one row.
SHEET_APPENDABLE_TABS=outreach_pocs,researcher_lines,events_summits

# THE COLUMNS THE BOT MAY FILL ON A *NEW* OUTREACH PoCs ROW.
#
# A:I ON AN EXISTING ROW STAYS AS LOCKED AS IT HAS ALWAYS BEEN. Those cells hold
# work somebody did, and the restricted bands exist to protect exactly that. A
# row the bot is CREATING has no such work in it — every cell is blank because
# the row did not exist a second ago — so filling A-I of a brand-new row
# destroys nothing, and it is the only way an appended row is any use at all.
#
# S-X IS ABSENT ON PURPOSE. Those are commercial judgements and a formula block;
# a bot that has just discovered a company has no business stating its closure
# probability. The bot warns at boot if you widen this into them.
NEW_ROW_WRITABLE_RANGES=A:R

# -----------------------------------------------------------------------------
# FOCUS COMMANDS
#
# "Prioritise only AI Voice Agents for the next two weeks." Sid or Vaishnavi can
# redirect prospecting at any time; R5 then offers matching contacts FIRST.
#
# A FOCUS NARROWS, IT DOES NOT SILENCE. When nothing on the sheet matches, R5
# SAYS SO and falls back to sheet order. That matters more than it sounds: a
# focus that accidentally matched nothing — a typo, an industry spelled
# differently in the sheet — would otherwise read exactly like a quiet week.
#
# How long a focus runs when no duration is given.
FOCUS_DEFAULT_DAYS=14

# The longest any focus may run. A focus is a deliberate, temporary narrowing;
# one set for six months is a strategy change wearing a command's clothes and
# belongs in sales_strategy.md instead.
FOCUS_MAX_DAYS=90

# Which Outreach PoCs roles a focus is matched against. "Only AI voice agents"
# means an industry; "only Wispr" a company; "only founders" a designation;
# "only London" a location — one command shape, four columns, and the bot is not
# told which. THE CELL MUST BE AT LEAST AS SPECIFIC AS THE FOCUS, never less: a
# focus on "Quantum Robotics" must not match every row whose industry says
# "Robotics".
FOCUS_MATCH_ROLES=industry,company,designation,based

# -----------------------------------------------------------------------------
# WHO EVERY CHANNEL MESSAGE TAGS
#
# Vaishnavi and Sid, on every proactive CHANNEL message, AT THE START of it.
# Strategy section 9: "Every channel message tags both Vaishnavi and Sid."
#
# AT THE START, NOT THE END. A tag after the paragraph is read after the
# paragraph, which is the wrong order for something that says "this is for you":
# a reader who sees their name first decides whether to read on, and one who
# sees it last has already decided not to.
#
# THE ITEM'S OWNER IS TAGGED TOO when that is somebody else — and ONCE, not
# twice, when it is one of these two. "@Vaishnavi @Sid @Vaishnavi" reads as a
# bot that cannot count.
#
# EVERY ID HERE MUST ALSO BE IN TEAM_ROSTER_IDS. The roster is the only thing
# that authorises a mention, so an id missing from it is named in PLAIN TEXT
# rather than pinged — which looks identical in the message and is not the same
# thing at all. The bot logs an ERROR at boot naming any that are missing.
#
# DMs ARE NOT TAGGED. A DM is already addressed to one person; opening it by
# tagging two others would be strange when one of them is not in it.
SALES_ALWAYS_TAG_IDS=<REQUIRED: ids tagged at the start of every drip post>

# -----------------------------------------------------------------------------
# THE NARROW DM EXCEPTION
#
# THE BAN IS STILL THE DEFAULT AND STILL ENFORCED IN CODE. `guardrails.send()`
# refuses any non-channel destination unless the caller passes an explicit
# `dm_reason` that `may_dm()` recognises, and there are exactly two:
#
#   (a) an item at least DM_OVERDUE_DAYS overdue — past its deadline, or past
#       its first reminder — sent to the person who owns it;
#   (b) R9's second and third meeting follow-ups (DM_MEETING_FOLLOWUP_RUNGS).
#
# And four conditions on both, every one checked in code:
#   - SALES_DMS_ENABLED must be on. It is OFF by default.
#   - the recipient must be in TEAM_ROSTER_IDS. A DM is the one path where
#     "outside the team" would be invisible to everybody but the recipient.
#   - the same item must not have gone to the channel the same day.
#   - every DM is written to state/audit.jsonl with the reason it was allowed —
#     more important here than anywhere else, because nobody else can see one.
#
# WITH THIS OFF, NOTHING IS DROPPED. R9's later rungs and the overdue
# escalation are still computed and still posted IN CHANNEL, addressed to the
# owner (or to ESCALATION_ADDRESSEE on the escalation rung).
#
# THE POST DOES NOT MENTION THE DM. Telling a team "this would have been a DM"
# explains the bot's configuration to somebody who only wants to know what to do
# about a meeting. The fallback is logged instead — grep the log for
# `[dm] fallback-to-channel` — so it is visible to whoever is running the bot
# and invisible to everybody else.
SALES_DMS_ENABLED=false

# Door (a)'s threshold, in days. The strategy doc's number is 3.
DM_OVERDUE_DAYS=3

# Door (b): which rungs of MEETING_FOLLOWUP_LADDER go by DM. 1-based, because
# that is how the ladder reads to a person counting it. The escalation rung goes
# to ESCALATE_TO_ID and is door (a)'s shape, not this one.
DM_MEETING_FOLLOWUP_RUNGS=2,3

# NEVER THE SAME ITEM IN THE CHANNEL AND A DM ON THE SAME DAY. This setting
# exists so the rule can be relaxed for a test run, and it should not be — the
# bot logs an ERROR at boot if you turn it on.
DM_SAME_DAY_AS_CHANNEL=false

# WHO AN ESCALATION IS ADDRESSED TO when it posts in the channel because DMs are
# off. Strategy section 8: Sid's word is final, so an escalation that cannot be
# a DM is a channel post with his name on it — not an unaddressed one everybody
# assumes somebody else is handling.
#
# WITH SALES_DMS_ENABLED=false, R9's rungs 2-3 post as ORDINARY channel
# follow-ups and the escalation rung posts in the channel addressed to this
# person. NO MESSAGE MENTIONS THE FALLBACK. It used to say "this would have
# been a DM", and that was the wrong thing to tell anybody — the reader does not
# care about the bot's delivery plumbing. It is logged instead, as
# `[dm] fallback-to-channel rung=N item=...`.
ESCALATION_ADDRESSEE=Sid

# -----------------------------------------------------------------------------
# THE LEAVE CHANNEL — the ONE non-sales channel the bot may read
#
# Before the bot addresses somebody, it checks whether they said they are off
# today. Addressing a person on leave is how a nudge becomes noise they come
# back to a week later.
#
# READ-ONLY, AND ENFORCED AS SUCH IN THREE PLACES: `guardrails.may_read` admits
# this one extra id, `guardrails.send` does NOT (its channel check is still
# SALES_CHANNEL_IDS alone), and `leave.read_leave_posts` refuses any channel
# that is not this one. Reading and writing have always been two separate gates
# in guardrails.py precisely so one could be widened without the other.
#
# DO NOT also put this id in SALES_CHANNEL_IDS — that would make it postable,
# and the bot warns at boot if you have.
#
# 0/unset turns the check off and everybody is addressed as though they are in.
HOLIDAY_CHANNEL_ID=

# How far back to read it. Leave is usually announced the day before or the
# morning of; a fortnight covers "I am off all next week" posted early.
HOLIDAY_LOOKBACK_DAYS=14

# How long a leave read is cached. Re-reading the channel for every addressed
# owner in a post would be several history scans for one message.
HOLIDAY_CACHE_MINUTES=30

# WHO THE WORK FALLS TO when its owner is away, in order. Owner on leave -> the
# first name; that person on leave -> the next; and so on.
#
# THE LAST NAME IS NEVER TREATED AS ON LEAVE. Sid is the backstop — not because
# he is never away, but because an item addressed to nobody is an item nobody
# chases, and the bot does not get to decide there is no one left to tell.
#
# LEAVE IS DETECTED BY THE MODEL, not by pattern-matching for "OOO". People
# announce it in prose ("heading out from Thursday, back Monday", "taking
# tomorrow off") and a regex over that either misses most of it or fires on "I
# am off to the client meeting". FAILS OPEN: an unreadable channel or a model
# outage resolves to "everybody is in".
LEAVE_FALLBACK_ORDER=Vaishnavi,Sid

ESCALATE_TO_ID=


# -----------------------------------------------------------------------------
# THE DRIP — a few short messages a day, instead of one long one
#
# THE ONE DAILY DIGEST IS RETIRED. Its format — one message at 10:00 carrying
# HOT / DEADLINES / OVERDUE / ESCALATIONS / HYGIENE plus five cadence sections,
# a tracker reminder, a to-do line and a funnel block, every item stamped
# "(3rd day)" — is gone, along with SALES_DIGEST_MAX_PER_SECTION.
#
# WHAT REPLACES IT. Each weekday the bot takes the next-action queue and GROUPS
# it, then sends at most DAILY_MESSAGE_CAP short messages, time-spaced:
#
#     ONE MESSAGE PER (ACTION TYPE x OWNER). Companies comma-separated, in one
#     sentence. NEVER two types in a message. NEVER two owners.
#
# That rule is the whole design. A message with one subject and one owner is
# answerable — "yes, done" means something. A wall of sections is a document,
# and nobody answers a document.
#
# WHAT DOES NOT CHANGE:
#   - the volume contract. Three messages was the point of the digest and it is
#     still the point here.
#   - the kill switch. Same name, same semantics, same log line — see below.
#   - REPLIES ARE IMMEDIATE. The spacing applies to PROACTIVE sends only.
#     Someone asking a question gets an answer straight away; so does the
#     ask-time deadline announcement.
# -----------------------------------------------------------------------------

# THE KILL SWITCH FOR EVERY UNPROMPTED MESSAGE. UNCHANGED, AND DELIBERATELY SO.
#
#   true / unset  the drip sends (the historical behaviour, which is why unset
#                 means on).
#   false         the bot sends NOTHING unprompted. Not a drip message, not a
#                 re-ask, nothing. There is no second switch to also check.
#
# THE NAME IS KEPT ON PURPOSE. This switch is currently false on the server, and
# an operator who set it that way to stop the bot talking must not discover that
# a rewrite quietly re-armed it under a new variable. The drip INHERITS this
# switch rather than introducing one of its own.
#
# WHAT DOES NOT STOP: everything still computes. Deadlines are tracked, the
# next-action queue is evaluated, SQLite and audit.jsonl are written. The bot
# still answers when @-mentioned ("cadence preview", "sheet status", sheet
# questions) and still announces a deadline when someone asks for one.
#
# It is read LIVE at send time, so flipping it takes effect on the next sweep
# tick without a restart. Each suppressed day logs exactly one line, in the same
# words it always used:
#   [digest] suppressed — SALES_DIGEST_ENABLED=false
# Setting it back to true resumes at the next scheduled slot; the skipped days
# are not replayed, because a suppressed day composed nothing and queued nothing.
SALES_DIGEST_ENABLED=true

# WHEN THE FIRST MESSAGE OF THE DAY GOES OUT, as HH:MM WALL-CLOCK IST
# (Asia/Kolkata, computed explicitly — never the server clock, which on a cloud
# box is UTC and would send at 15:30 local). A message can only go out on a
# sweep tick, so the first lands at the first tick at or after this time; see
# COS_FOLLOWUP_CHECK_INTERVAL_MINUTES.
#
# SALES_DIGEST_TIME is still read as an ALIAS for this, so an existing .env keeps
# working. SALES_DRIP_START wins if both are set.
SALES_DRIP_START=14:00

# The alias. BOTH LINES ARE SET HERE, to the same time — change them together,
# or change the one above and delete this one. Editing only this line does
# nothing, because the name above is set and wins.
SALES_DIGEST_TIME=14:00

# THE END OF THE POSTING WINDOW. Nothing proactive lands after this, ever.
#
# WITHOUT IT THE DAY HAD NO CEILING. Six posts at 90-minute gaps from 14:00 ran
# to 21:13 — the cap kept the COUNT down and nothing kept the last one out of
# somebody's evening. A message at nine at night is not read that night and is
# resented in the morning.
#
# HOW THE FIT WORKS, in order:
#   1. try MESSAGE_GAP_MINUTES between every post;
#   2. if that overruns the end, shrink the gap EVENLY until the day fits —
#      every post moves, none is singled out;
#   3. never below MESSAGE_GAP_MIN_MINUTES;
#   4. whatever still does not fit ROLLS to the next applicable day, where it
#      goes FIRST — ahead of that day's own items, because it already waited.
#
# THE ONE EXCEPTION IS R8's DAY-OF TOUCH, which keeps MEETING_DAYOF_TIME
# (10:00) — a note about a meeting that starts at 11 is worthless at 14:00.
SALES_DRIP_END=18:30

# HOW MANY PROACTIVE MESSAGES A WEEKDAY, EVER. The volume contract, and a HARD
# ceiling rather than a target: three short messages is what a busy channel
# absorbs without learning to skim past them.
#
# Anything over the cap ROLLS TO TOMORROW rather than being dropped — with one
# exception: a group that has become a positive override (somebody replied) is
# ranked first and takes a slot today, because a reply that waits a day is a
# reply that goes cold.
DAILY_MESSAGE_CAP=3

# ...AND THE PER-DAY SHAPE, which is what the schedule actually needs. Monday
# and Tuesday carry more rules than Wednesday, so a single scalar either
# throttled those two or let the quiet days run loose.
#
# Any day not named here falls back to DAILY_MESSAGE_CAP. SATURDAY IS ABSENT ON
# PURPOSE: the day is silent and `is_sending_day` refuses it before a cap is
# ever consulted, so an entry for it would do nothing (and the bot says so at
# boot if you add one).
#
# SUNDAY IS 1 AND THAT IS NOT A TYPO — see SUNDAY_RULE_IDS below.
DAILY_MESSAGE_CAP_BY_DAY=mon:4,tue:4,wed:3,thu:3,fri:3,sun:1

# RULES R8 AND R9 DO NOT COUNT AGAINST THE CAP AT ALL. That is declared per-rule
# in bot_rules.yaml (`counts_toward_cap: false`), not here. A meeting is
# happening whether or not Monday's chases fit, and letting a Monday chase crowd
# out the prep for it is the opposite of what a volume cap is for. A day can
# therefore legitimately carry MORE posts than its cap — the simulation in
# `verify_monday.py` produces six posts against a cap of four.

# MINUTES BETWEEN PROACTIVE MESSAGES. Three messages in one minute is one long
# message with extra steps. The spacing is what makes each land as its own thing
# and gives the person time to act on the first before the second arrives.
#
# IT ALSO PACES CATCH-UP. After a quiet morning — the kill switch off until
# 14:00, an outage — several slots are past due at once, and the gap is measured
# from the LAST ACTUAL SEND so the backlog drains at the drip's own pace rather
# than arriving as a burst.
MESSAGE_GAP_MINUTES=90

# ...PLUS OR MINUS THIS MANY MINUTES. A bot that posts at exactly 10:00, 11:30
# and 13:00 every day reads as a script, and people start filing it as one.
#
# THE JITTER IS DETERMINISTIC — seeded on the date and the slot number, never on
# the clock — so every sweep tick and every restart recomputes the SAME schedule.
# That is what makes the per-slot restart guard work. Set to 0 for exact spacing.
#
# The floor on the gap is MESSAGE_GAP_MINUTES minus this, which is 75 minutes at
# the defaults. That is the number the volume contract is written against.
MESSAGE_JITTER_MINUTES=15

# THE FLOOR THE GAP MAY SHRINK TO when a day will not otherwise fit inside the
# posting window. Below this the messages stop reading as separate things and
# start reading as one long one delivered in instalments — which is the failure
# the spacing exists to prevent, so the day ROLLS its overflow rather than
# squeezing any harder.
#
# NOTE this is now the real floor reported by the volume contract. It used to be
# gap minus jitter (75); on a compressed day it is this.
MESSAGE_GAP_MIN_MINUTES=30

# ONE GENTLE RE-ASK, this many days after a nudge nobody actioned — softer
# words, and it says it is the last one. After that the subject returns to the
# normal cadence and is never re-asked again for that nudge. Two asks is a
# reminder; three is nagging, and nagging is what gets a bot muted.
DRIP_REASK_DAYS=2

# WEEKDAYS ONLY. The same instinct as the next-action engine's weekend shift,
# applied to the sending rather than to the due date: a nudge that lands on a
# Saturday is read on Monday anyway, having spent the weekend as an unread
# badge. Set false to send every day.
DRIP_WEEKDAYS_ONLY=true

# HOW MANY ITEMS ONE POST CARRIES before the rest roll to that rule's next
# scheduled day. A sentence listing twenty companies is a list wearing a
# sentence's clothes.
#
# THE OVERFLOW ROLLS, IT IS NOT TRIMMED. A rule that produced nine items and may
# say five has four waiting for its next run — not four dropped. Both the plan
# and `cadence preview` report the number waiting, because silently losing four
# prospects is the failure this cap could otherwise cause.
DRIP_MAX_ITEMS_PER_POST=5

# THE OLD NAME, KEPT AS AN ALIAS so an existing .env keeps working. The new name
# wins when both are set. It was renamed because a rule's items are no longer
# always companies — R4 carries deliverables, R12 carries packages — and the old
# name had stopped describing what it capped. Both lines are set here, to the
# same number: change them together, or edit only the new name above.
DRIP_MAX_COMPANIES_PER_MESSAGE=5

# WHICH RULES MAY SEND ON A SUNDAY, and nothing else may.
#
# SATURDAY IS SILENT OUTRIGHT. Sunday carries ONE post, at SALES_DRIP_START, and
# only for Deliverables Checklist items whose deadline falls on the Monday — a
# P1 due Monday morning is the one thing that cannot wait until Monday morning
# to be mentioned. A deliverable due on Thursday is not a Sunday problem and
# does not spend the one weekend message the team tolerates.
#
# A rule-id list rather than a boolean, because "the weekend is silent except
# for this one thing" is a rule about WHICH thing. Empty = Sunday is silent too.
#
# NO PUBLIC-HOLIDAY HANDLING, deliberately and stated rather than left as an
# absence: the bot posts on a public holiday exactly as it would on a weekday.
# HOLIDAY_CHANNEL_ID covers a PERSON being away; a whole team being away is what
# SALES_DIGEST_ENABLED is for.
SUNDAY_RULE_IDS=R4

# Compose the message text with the model, in the ten voice exemplars in
# sales_policy.md ("### Voice exemplars"). Those are read FRESH on every message,
# so the team rewrites the bot's proactive voice by editing a markdown file — no
# restart, no deploy.
#
# Off, or on any model failure, or when the model returns something that breaks
# the voice rules (a bulleted list, a header, an emoji, four paragraphs), the
# message falls back to a deterministic template. That template is still one
# sentence, still names every company, and still ends with an out — a model
# outage costs polish, never the message.
DRIP_LLM_COMPOSE=true

# -----------------------------------------------------------------------------
# TONE — five dials, read FRESH ON EVERY MESSAGE
#
# Strategy section 9 says tone should be "adjustable in configuration without
# changing this file". These are that configuration.
#
# NO RESTART NEEDED, and that is deliberate. Every other setting in this file is
# read once at import — for things that must not change mid-run — but tone reads
# the environment on every compose. Change a dial, and the NEXT message is
# different. Nothing else in the bot behaves this way.
#
# TWO OF THE FIVE ARE ENFORCED IN CODE. SALEY_EMOJI and SALEY_LENGTH go into the
# prompt AND into the voice-rule checker, which throws away a composed message
# that breaks either and sends the deterministic template instead. The other
# three are prompt-only: a message 10% too formal is still a good message, and
# rejecting it would cost more than it saved.
#
# A BAD VALUE FALLS BACK AND LOGS ONCE. A typo in a tone dial must not stop the
# bot talking.

# low | medium | high. HIGH sounds like somebody on the team who noticed and
# cared enough to mention it — first names, thanks where earned, good news
# acknowledged. Warmth is one clause, never an extra sentence.
SALEY_WARMTH=high

# casual | balanced | formal. CASUAL is how people actually type in a team
# channel ("worth a look when you get a window"); FORMAL drops contractions and
# slang. Formal never means longer.
SALEY_FORMALITY=balanced

# none | light | expressive. ENFORCED: at most 0, 1 or 3 emoji respectively, and
# a message over the limit is thrown away.
#
# LIGHT MEANS AT MOST ONE, usually none. The default is light rather than none
# because a small acknowledgement of good news reads as a person; a nudge
# decorated with an emoji does not.
SALEY_EMOJI=light

# short | medium. ENFORCED: at most 3 or 6 SENTENCES respectively.
#
# SENTENCES, NOT CHARACTERS. The old check capped bytes at 600, which is
# comfortably four long sentences — it could not express "one to three".
SALEY_LENGTH=short

# off | light. OFF by default: friendly is not the same as funny, and a joke in
# a nudge somebody is already behind on reads badly.
SALEY_HUMOUR=off

# Which sales channel the drip sends in. Must be one of SALES_CHANNEL_IDS; an
# out-of-scope id is ignored with a warning. Unset → SALES_ASK_CHANNEL_ID, else
# the first channel in SALES_CHANNEL_IDS. Kept under its old name because it is
# the same channel the digest used.
SALES_DIGEST_CHANNEL_ID=


# -----------------------------------------------------------------------------
# ROW HYGIENE FLAGS — RETIRED
#
# SHEET_FLAGS_ENABLED and STALLED_AFTER_DAYS are GONE from config.py, along with
# MAX_FLAGS_PER_SWEEP before them. Setting any of the three now does nothing.
#
# The three flags they controlled — HOT, STALLED, DEAD-DEAL — were the old
# per-row "what next" logic, and the NEXT-ACTION STATE MACHINE above replaces
# them. Where each judgement went:
#
#   HOT        -> R5 and R10. A replied row is picked up by the prospect rules
#                 and a high-closure deal by CLOSURE_SUPPORT_MIN. Same instinct,
#                 but it now says what to DO rather than flagging a mood.
#   STALLED    -> whichever of the twelve rules owns that kind of silence — R6
#                 for a connection with no DM, R7 for a DM with no meeting, R9
#                 for a meeting with no next steps. Each carries its own
#                 interval in bot_rules.yaml, so a 20% deal is no longer chased
#                 on the same clock as a 90% one.
#   DEAD-DEAL  -> split in two, honestly. A row somebody has actually closed
#                 (CLOSURE_STOP_MARKERS) now STOPS and is never chased again; a
#                 row that is merely untidy keeps its ordinary follow-up. The
#                 old flag conflated "finished" with "missing a Next Steps
#                 cell", and only one of those is news.
#
# The digest's HOT and HYGIENE sections are unwired with them. The state machine
# deliberately has no proactive outlet yet — see NEXT_ACTION_ENABLED above.


# -----------------------------------------------------------------------------
# WEEKLY FUNNEL NUMBERS
#
# LEADING (outreach sent, reply rate, meetings booked, follow-ups done vs due)
# then LAGGING (pilots, paid, repeats). Leading first because those are the
# numbers still changeable.
#
# THESE HAVE NO PROACTIVE OUTLET RIGHT NOW. They used to be their own scheduled
# post, then a section of the daily digest — and the digest is retired. The drip
# carries per-(type x owner) ASKS, and a block of numbers addressed to nobody is
# not one of those. The numbers are still computed and still answered on demand;
# what is gone is the scheduled block. Re-surfacing them means deciding who a
# funnel message is FOR, which is a product question, not a config one.
# -----------------------------------------------------------------------------

WEEKLY_DIGEST_ENABLED=true
# 0=Monday … 4=Friday … 6=Sunday. Which day's daily digest carries the numbers.
WEEKLY_DIGEST_WEEKDAY=4
# WEEKLY_DIGEST_HOUR_IST is RETIRED, and so is the block it timed — see the
# RETIRED block at the bottom of this file.
# Kept as an alias for SALES_DIGEST_CHANNEL_ID so an existing .env keeps
# working. SALES_DIGEST_CHANNEL_ID wins if both are set.
WEEKLY_DIGEST_CHANNEL_ID=


# -----------------------------------------------------------------------------
# DEADLINE CHASING
#
# Someone commits in a sales channel ("I'll send the deck tomorrow") and the bot
# records it, with the deadline machinery below.
#
# THE OVERDUE SECTION THAT SURFACED THESE IS RETIRED WITH THE DIGEST, and the
# drip does not yet carry them: it groups the next-action queue, and a chase is
# not an action type on that queue. Everything below still TRACKS — the promise,
# the deadline, the attempt count, the escalation threshold — and it is all
# answerable on demand. What is gone is the unprompted line about it.
# -----------------------------------------------------------------------------

# Master switch for chasing. false → the bot still answers questions but never
# tracks a commitment or a deadline at all.
COS_FOLLOWUP_ENABLED=true

# How often the sweeper wakes up. The only thing a tick can put into Discord is
# ONE drip message, and only when a slot is due and the spacing floor has
# elapsed. Keep this well under an hour, or messages drift late from their
# planned times and the spacing stretches.
COS_FOLLOWUP_CHECK_INTERVAL_MINUTES=15

# Fallback deadline when someone promises with no time attached ("will send it
# after the call"). 480 = 8 hours.
COS_FOLLOWUP_DEFAULT_DUE_MINUTES=480

# The model must be at least this confident that a message really was a
# commitment before it's tracked. A false chase nags someone about a promise they
# never made, which is worse than missing a real one — raise this, don't lower it.
COS_FOLLOWUP_MIN_CONFIDENCE=0.6

# COS_MAX_NUDGES_PER_SWEEP is RETIRED — see the block at the bottom of this
# file. It capped how many chases could post in one sweep, which only mattered
# when chases posted individually. The cap that matters now is
# DAILY_MESSAGE_CAP_BY_DAY, which is per weekday rather than one scalar.

# --- THE ATTEMPT CAP ---
# Retained for the `nudges` log and for the escalation threshold. With the
# digest's OVERDUE section retired there is no unprompted chase to pace, so
# these bound the record rather than the talking.
COS_NUDGE_WINDOW_HOURS=24
# Most times ONE promise or deadline may be chased. After this it stops being
# the owner's problem and moves to the digest's ESCALATIONS section, addressed
# to ESCALATE_TO_ID, where it stays until resolved. Stopping the chase is
# deliberate — a bot that keeps asking gets muted, and a muted bot enforces
# nothing.
COS_NUDGE_MAX_ATTEMPTS=2


# -----------------------------------------------------------------------------
# STORAGE & STATE
# -----------------------------------------------------------------------------

# This bot's OWN SQLite file. Never point it at the PM bot's bot_state.db.
DB_PATH=./sales_bot.db

# -----------------------------------------------------------------------------
# SIMULATION AND TEST MODE
#
# "@bot simulate monday" in the test channel and the bot posts the exact
# messages it would send on the next Monday, in order, with a footer saying what
# rolled, what was skipped and why.
#
# COMMANDS (test channel only, approvers only):
#   simulate monday ... simulate sunday   the NEXT occurrence of that weekday
#   simulate 2026-09-28                   a specific date
#   simulate week                         Mon-Sun in order, each with a header
#   simulate rule R8                      one rule, on the next date it fires
#   ...add "fast" (the default) or "real" for the spacing
#
# TEST HELPERS (same gates):
#   pretend Kushal is on leave today / clear leave
#   advance clock 3 days / reset clock    (SALES_TEST_MODE only)
#   reset test state                      (refuses unless DB_PATH is a *_test.db)
#
# ISOLATION — a simulation leaves NO TRACE:
#   - it runs on a COPY of the database, discarded afterwards. Without that, a
#     simulated week would claim every drip slot for those dates, mark
#     conferences as reminded FOREVER (`event_reminders` rows are never
#     removed), record proposals and spend the web-search budget.
#   - sheet writes are ALWAYS dry-run, whatever SHEET_WRITES_ENABLED says.
#     There is no flag to turn this off and there must not be one.
#   - DMs are POSTED as "[DM to Vaishnavi] ...", never sent.
#   - it works with SALES_DIGEST_ENABLED=false — "the bot is off" is exactly
#     when somebody wants to ask what it would have said.
#   - every simulated message is prefixed "[TEST]".
# -----------------------------------------------------------------------------

# WHERE SIMULATIONS LIVE. Commands are typed here and simulated messages are
# posted here, and nowhere else. A "simulate week" typed in the real sales
# channel does NOTHING AT ALL — not even a refusal, because a refusal there is
# itself a message the team has to read.
#
# IT IS ADDED TO THE BOT'S CHANNEL SCOPE AUTOMATICALLY, exactly as
# SALES_ASK_CHANNEL_ID is. Set one variable; you do not also have to remember
# SALES_CHANNEL_IDS.
#
# 0/unset turns simulation off entirely.
SALES_TEST_CHANNEL_ID=

# LIVE TEST MODE. Redirects ALL real proactive output — the drip, the proposal
# sweep, escalations and DMs — into the test channel, with NORMAL STATE AND REAL
# TIMING. It is NOT a simulation and does not pretend to be: slots are claimed,
# events are marked sent, proposals are recorded. It exists to test replies,
# approvals, undo and appends end to end.
#
# POINT DB_PATH AT A *_test.db AND GTM_SHEET_ORIGINAL_ID AT A COPY FIRST.
SALES_TEST_MODE=false

# Whether a simulated message actually pings anybody. OFF by default: a
# simulated week would otherwise put forty notifications on two people's phones
# for messages that are not real. Names render as plain "@Vaishnavi" text.
SIMULATION_REAL_MENTIONS=false

# The gap between simulated posts in "fast" mode, in seconds. Long enough to
# read in order, short enough that a week does not take an afternoon.
SIMULATION_FAST_GAP_SECONDS=5

# The ceiling on one simulation, in seconds. "real" spacing is COMPRESSED to
# fit inside this — the planned times are still reported exactly, only the
# waiting is shortened. A week at true spacing would run for days.
SIMULATION_MAX_SECONDS=900

# The marker on every simulated message. One string, so it can be grepped for
# and so nothing can post a simulated message without carrying it.
SIMULATION_PREFIX=[TEST]

# Where the state contract is written: summary.json (rewritten at startup and
# daily) and audit.jsonl (append-only, one line per action). Both schemas are
# documented in README.md so a supervisor process can consume them.
STATE_DIR=./state

# Local hour (0–23, server time) for the daily summary.json rewrite. The startup
# rewrite happens regardless.
STATE_DAILY_HOUR=8


# -----------------------------------------------------------------------------
# QUERY BEHAVIOUR  (defaults are sensible; tune only if answers feel wrong)
# -----------------------------------------------------------------------------

# Default look-back for a person-scoped activity scan.
QUERY_DISCORD_LOOKBACK_DAYS=14
# Hard cap on messages read per channel in any one scan — the main cost control.
QUERY_MAX_MESSAGES_PER_CHANNEL=400

# "What's been happening" digest: default and maximum window, and how many
# messages come back (the per-channel and per-person counts always cover
# everything scanned, even when the list is truncated).
QUERY_CHANNEL_SCAN_DEFAULT_DAYS=2
QUERY_CHANNEL_SCAN_MAX_DAYS=14
QUERY_CHANNEL_DIGEST_MAX_MESSAGES=60

# Keyword history search: how far back it may look, how many matches come back,
# and how many messages of context accompany each match. Keep the context — a
# reply posted without a reply-to is only interpretable next to what it follows.
QUERY_HISTORY_MAX_DAYS=60
QUERY_HISTORY_MAX_MATCHES=8
QUERY_HISTORY_MAX_CONTEXT=6

# Tool-use loop bounds. On hitting the iteration cap the bot still answers, and
# says which sources it didn't get to check.
QUERY_ENGINE_MAX_TOOL_ITERATIONS=8
QUERY_ENGINE_MAX_TOKENS=1536

# Reply splitting. Discord hard-caps a message at 2000 characters.
QUERY_REPLY_CHUNK=1900
QUERY_REPLY_MAX_MESSAGES=4

# Short-term per-channel memory, so a follow-up ("and Globex?") carries the
# previous subject forward. In-memory only; lost on restart, never persisted.
QUERY_MEMORY_TURNS=5
QUERY_MEMORY_TTL_MINUTES=10


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR. DEBUG is loud but shows every skipped channel
# and every routing decision, which is what you want while setting the bot up.
LOG_LEVEL=INFO


# =============================================================================
# RETIRED — setting any of these does NOTHING
#
# Every name below was once live in this file. The code no longer reads any of
# them, so a value set here is inert: no warning, no error, no effect.
#
# THEY ARE LISTED RATHER THAN DELETED because a name that vanishes silently is
# indistinguishable from a name that never existed. Somebody upgrading an old
# .env needs to know that their carefully tuned FOLLOWUP_STALE_DAYS is now
# doing nothing at all, and what took over from it.
#
# They stay commented. A live line here would be a setting; a commented one is
# a record.
# =============================================================================

# -- The phase-1 cadence (rules a-j). Replaced wholesale by the twelve rules ---
# Each of R1-R12 carries its OWN interval in bot_rules.yaml, which is the point:
# "how long is too long" is a different number for a connection with no DM than
# for a meeting with no next steps, and one setting could never be both.
#
# FOLLOWUP_STALE_DAYS=          -> R7's DM_NO_MEETING_DAYS
# FOLLOWUP_GRACE_DAYS=          -> each rule's own interval in bot_rules.yaml
# CONNECT_REMINDER_DAYS=        -> R6's LI_NO_DM_DAYS
# CONNECT_REMINDER_MAX_DAYS=    -> R6's LI_NO_DM_DAYS
# CONNECT_DM_CHECK_HOURS=       -> R6, which asks a better question: it says
#                                  whether an email is on file, not only whether
#                                  a DM went out
# CONNECTION_DM_CHECK_DAYS=     -> R6's LI_NO_DM_DAYS
# DM_PROGRESS_CHECK_DAYS=       -> R7's DM_NO_MEETING_DAYS
# DEMO_QUOTE_DAYS=              -> R10's CLOSURE_SUPPORT_MIN / _STAGES
# MEETING_PROPOSAL_WORKING_DAYS= -> each rule's own interval in bot_rules.yaml
# NEXTSTEP_STALL_DAYS=          -> R9's MEETING_FOLLOWUP_AFTER_DAYS
# ALT_CHANNEL_AT=               -> nothing. The channel-switch counsel is gone
# CHANNEL_SWITCH_AT=            -> nothing. Same rule
# UNRESPONSIVE_AT=              -> TERMINAL_STATUS_WORDS / CLOSURE_STOP_MARKERS.
#                                  A HUMAN marks a contact unresponsive; the bot
#                                  honours it the moment they do, and never
#                                  decides it by counting
# UNRESPONSIVE_SUGGEST_AT=      -> as above
# UPDATE_TRACKER_MAX=           -> the permission flow. Nothing is written
#                                  without a proposal and a yes; the ceiling is
#                                  SHEET_WRITE_MAX_CELLS
# CADENCE_CROSSCHECK_ENABLED=   -> nothing. The master/tracker cross-check went
# CADENCE_CROSSCHECK_MAX=          with the tracker tab it compared against

# -- The two-lane split. R10 gates on closure probability directly -------------
# SLOW_LANE_DAYS=               -> CLOSURE_SUPPORT_MIN
# HOT_DEAL_DAYS=                -> CLOSURE_SUPPORT_MIN
# CLOSURE_HOT_THRESHOLD=        -> CLOSURE_SUPPORT_MIN
# ON_HOLD_PULSE_DAYS=           -> DEAL_ON_HOLD_MARKERS, which now only
#                                  IDENTIFIES a parked deal so an answer can say
#                                  it is parked. Nothing pulses at it

# -- The row-hygiene flags (HOT / STALLED / DEAD-DEAL) -------------------------
# The flags answered "is something wrong with this row"; the rules answer "what
# is the single next thing somebody does about it".
#
# SHEET_FLAGS_ENABLED=          -> NEXT_ACTION_ENABLED
# STALLED_AFTER_DAYS=           -> the twelve rules
# MAX_FLAGS_PER_SWEEP=          -> DAILY_MESSAGE_CAP_BY_DAY

# -- The sandbox copy. The bot writes into the real playbook -------------------
# What protects the sheet is the permission flow and the column bands, not a
# second document.
#
# GTM_SHEET_COPY_ID=            -> GTM_SHEET_ORIGINAL_ID, written in place
# SHEET_WRITE_TARGET=           -> nothing to choose between any more
# BOT_DEADLINE_COLUMN=          -> NEW_ROW_WRITABLE_RANGES and
#                                  RESTRICTED_COLUMN_RANGES. The bot no longer
#                                  owns a column of its own; it writes the
#                                  playbook's own columns, inside a window
# SALES_SPREADSHEET_ID=         -> GTM_SHEET_ORIGINAL_ID
# SALES_SPREADSHEET_FILE=       -> GTM_SHEET_ORIGINAL_ID

# -- The daily digest format ---------------------------------------------------
# The digest is retired; the drip replaced it. See SALES_DRIP_START.
#
# WEEKLY_DIGEST_HOUR_IST=       -> WEEKLY_DIGEST_WEEKDAY picks the day; the
#                                  numbers ride a drip slot, so there is no
#                                  hour of its own to set any more
# SALES_DIGEST_MAX_PER_SECTION= -> DRIP_MAX_ITEMS_PER_POST
# COS_MAX_NUDGES_PER_SWEEP=     -> DAILY_MESSAGE_CAP_BY_DAY. It capped chases per
#                                  sweep, which only mattered when chases posted
#                                  individually
